+	ExpectedUpdatedAt json.RawMessage `json:"expected_updated_at"`
+
 	// This is only relevant to campaign test requests.
 	SubscriberEmails pq.StringArray `json:"subscribers"`
 }
 
+// Parse a caller-reviewed revision, distinguishing an explicit null database value from
+// the omitted field used by the standalone Listmonk admin client.
+func requestedCampaignRevision(raw json.RawMessage) (*null.Time, error) {
+	if len(raw) == 0 {
+		return nil, nil
+	}
+	var revision null.Time
+	if err := json.Unmarshal(raw, &revision); err != nil {
+		return nil, echo.NewHTTPError(http.StatusBadRequest, "Invalid expected campaign revision")
+	}
+	return &revision, nil
+}
