 -- name: update-list
-WITH l AS (
-    UPDATE lists SET
+-- Lock the current opt-in mode before deciding whether this edit may proceed.
+WITH target AS MATERIALIZED (
+    SELECT id, optin AS current_optin FROM lists WHERE id = $1 FOR NO KEY UPDATE
+), l AS (
+    UPDATE lists AS list SET
         name=(CASE WHEN $2 != '' THEN $2 ELSE name END),
         type=(CASE WHEN $3 != '' THEN $3::list_type ELSE type END),
         optin=(CASE WHEN $4 != '' THEN $4::list_optin ELSE optin END),
@@ -65,13 +68,14 @@ WITH l AS (
         tags=$6::VARCHAR(100)[],
         description=(CASE WHEN $7 != '' THEN $7 ELSE description END),
         updated_at=NOW()
-    WHERE id = $1
-    RETURNING id, name
+    FROM target
+    WHERE list.id = target.id AND NOT (target.current_optin = 'double' AND $4 = 'single')
+    RETURNING list.id, list.name
 ),
 c AS (
     UPDATE campaign_lists SET list_name = l.name FROM l WHERE campaign_lists.list_id = l.id RETURNING 1
 )
-SELECT COUNT(*) FROM l, c;
+SELECT EXISTS (SELECT 1 FROM l) AS updated, EXISTS (SELECT 1 FROM target) AS found;
 
