+{{ define "warpdrive-crm-identity" }}
+{{ template "header" . }}
+<h2>Confirm your newsletter request</h2>
+{{ if .Newsletter }}
+<p>Review and confirm the requested newsletter subscription for this mailbox.</p>
+{{ else }}
+<p>Confirm control of this mailbox for the Warpdrive contact association. This does not subscribe you to a list.</p>
+{{ end }}
+<p><a href="{{ .URL }}" class="button">Review request</a></p>
+<p>This link expires in 30 minutes. You can ignore this email if you did not request it.</p>
+{{ template "footer" }}
+{{ end }}
