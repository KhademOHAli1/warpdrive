+	"log"
+	"math/big"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"os"
+	"slices"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/gofrs/uuid/v5"
+	"github.com/jmoiron/sqlx"
+	_ "github.com/lib/pq"
+)
+
+const testTopic = "arn:aws:sns:us-east-1:123456789012:WarpdriveFeedback"
+const testSet = "WarpdriveFixture"
+
+type roundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f roundTripFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+type signedFixture struct {
+	t            *testing.T
+	verification *verifier
+	key          *rsa.PrivateKey
+	certURL      string
+	gets         atomic.Int64
+}
+
+func newSignedFixture(t *testing.T) *signedFixture {
+	t.Helper()
+	config, err := ParseConfig(testTopic, testSet)
+	must(t, err)
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	must(t, err)
+	now := time.Now()
+	certificate := &x509.Certificate{SerialNumber: big.NewInt(1), NotBefore: now.Add(-90 * 24 * time.Hour),
+		NotAfter: now.Add(30 * 24 * time.Hour), KeyUsage: x509.KeyUsageDigitalSignature}
+	der, err := x509.CreateCertificate(rand.Reader, certificate, certificate, &key.PublicKey, key)
+	must(t, err)
+	cert := string(pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}))
+	f := &signedFixture{t: t, verification: newVerifier(config), key: key,
+		certURL: "https://sns.us-east-1.amazonaws.com/SimpleNotificationService-11112222333344445555666677778888.pem"}
+	f.verification.client.Transport = roundTripFunc(func(r *http.Request) (*http.Response, error) {
+		f.gets.Add(1)
+		switch {
+		case r.Method != http.MethodGet:
+			return nil, errors.New("unexpected verification method")
+		case r.URL.String() == f.certURL:
+			return response(cert), nil
+		case r.URL.Host == config.snsHost() && r.URL.Query().Get("Action") == "ConfirmSubscription":
+			return response("<ConfirmSubscriptionResponse/>"), nil
+		default:
+			return nil, fmt.Errorf("fixture would have accessed an unexpected URL")
+		}
+	})
+	return f
+}
+
+func response(body string) *http.Response {
+	return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader(body))}
+}
+
+func must(t *testing.T, err error) {
+	t.Helper()
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+
+func randomID() string { return uuid.Must(uuid.NewV4()).String() }
+
+func (f *signedFixture) envelope(event string) envelope {
+	return envelope{Type: "Notification", TopicARN: testTopic, MessageID: randomID(),
+		Timestamp: time.Now().UTC().Format(time.RFC3339Nano), SignatureVersion: "2",
+		Message: event, SigningCertURL: f.certURL}
+}
+
+func (f *signedFixture) sign(message envelope) envelope {
+	// Construct the field-sorted fixture separately from the verifier.
+	fields := map[string]string{"Type": message.Type, "Message": message.Message, "MessageId": message.MessageID,
+		"TopicArn": message.TopicARN, "Timestamp": message.Timestamp}
+	if message.Type == "Notification" && message.Subject != nil {
+		fields["Subject"] = *message.Subject
+	}
+	if message.Type != "Notification" {
+		fields["SubscribeURL"], fields["Token"] = message.SubscribeURL, message.Token
+	}
+	keys := make([]string, 0, len(fields))
+	for key := range fields {
+		keys = append(keys, key)
+	}
+	slices.Sort(keys)
+	var canonical strings.Builder
+	for _, key := range keys {
+		fmt.Fprintf(&canonical, "%s\n%s\n", key, fields[key])
+	}
+	digest := sha256.Sum256([]byte(canonical.String()))
+	signed, err := rsa.SignPKCS1v15(rand.Reader, f.key, crypto.SHA256, digest[:])
+	must(f.t, err)
+	message.Signature = base64.StdEncoding.EncodeToString(signed)
+	return message
+}
+
+func snsRequest(message envelope) *http.Request {
+	raw, _ := json.Marshal(message)
+	req := httptest.NewRequest(http.MethodPost, "/webhooks/warpdrive/ses", strings.NewReader(string(raw)))
+	req.Header.Set("X-Amz-Sns-Message-Type", message.Type)
+	req.Header.Set("X-Amz-Sns-Message-Id", message.MessageID)
+	req.Header.Set("X-Amz-Sns-Topic-Arn", message.TopicARN)
+	return req
+}
+
+func requestStatus(h http.Handler, message envelope) int {
+	response := httptest.NewRecorder()
+	h.ServeHTTP(response, snsRequest(message))
+	return response.Code
+}
+
+func TestSNSv2Validation(t *testing.T) {
+	f := newSignedFixture(t)
+	subject := "Verified fixture"
+	original := f.envelope("event containing\nnewlines")
+	original.Subject = &subject
+	signed := f.sign(original)
+	must(t, f.verification.verify(context.Background(), signed, snsRequest(signed).Header))
+	if f.gets.Load() != 1 {
+		t.Fatal("regional cert fetched exactly once")
+	}
+
+	invalid := []func(*envelope){
+		func(m *envelope) { m.Message = "tampered" },
+		func(m *envelope) { m.SignatureVersion = "1" },
+		func(m *envelope) { m.SigningCertURL = strings.Replace(m.SigningCertURL, "us-east-1", "us-west-2", 1) },
+		func(m *envelope) {
+			m.SigningCertURL = strings.Replace(m.SigningCertURL, "amazonaws.com", "amazonaws.com.example.test", 1)
+		},
+		func(m *envelope) { m.SigningCertURL = strings.Replace(m.SigningCertURL, "https://", "http://", 1) },
+		func(m *envelope) { m.SigningCertURL += "?ignored=yes" },
+		func(m *envelope) { m.SigningCertURL = "https://sns.us-east-1.amazonaws.com@127.0.0.1/fake.pem" },
+		func(m *envelope) { m.TopicARN += "Unexpected" },
+	}
+	for i, alter := range invalid {
+		candidate := signed
+		alter(&candidate)
+		if err := f.verification.verify(context.Background(), candidate, snsRequest(candidate).Header); !errors.Is(err, ErrDenied) {
+			t.Fatalf("forgery %d returned %v", i, err)
+		}
+	}
+	if f.gets.Load() != 1 {
+		t.Fatal("untrusted certificate targets caused a network request")
+	}
+	confirmation := f.envelope("Confirm synthetic subscription")
+	confirmation.Type = "SubscriptionConfirmation"
+	confirmation.Token = "0123456789abcdef0123456789abcdef"
+	confirmation.SubscribeURL = "https://" + f.verification.config.snsHost() + "/?" + url.Values{
+		"Action": {"ConfirmSubscription"}, "TopicArn": {testTopic}, "Token": {confirmation.Token},
+	}.Encode()
+	confirmation = f.sign(confirmation)
+	must(t, f.verification.verify(context.Background(), confirmation, snsRequest(confirmation).Header))
+	must(t, f.verification.confirm(context.Background(), confirmation))
+	confirmation.SubscribeURL = strings.Replace(confirmation.SubscribeURL, "ConfirmSubscription", "Unsubscribe", 1)
+	if err := f.verification.confirm(context.Background(), confirmation); !errors.Is(err, ErrDenied) {
+		t.Fatal("confirmation accepted a different AWS action")
+	}
+}
+
+type testJob struct {
+	delivery, email      string
+	campaign, subscriber int
+}
+
+func seedJob(t *testing.T, db *sqlx.DB, email, state string) testJob {
+	t.Helper()
+	job := testJob{email: email, delivery: randomID()}
+	must(t, db.Get(&job.campaign, `
+		INSERT INTO campaigns(uuid,name,subject,from_email,body,status,messenger,sent)
+		VALUES(gen_random_uuid(),'SES fixture','SES fixture','sender@example.test','Synthetic','paused','email',
+		       CASE WHEN $1='accepted' THEN 1 ELSE 0 END) RETURNING id
+	`, state))
+	must(t, db.Get(&job.subscriber, "INSERT INTO subscribers(uuid,email,name) VALUES(gen_random_uuid(),$1,'Synthetic') RETURNING id", email))
+	_, err := db.Exec("INSERT INTO warpdrive_delivery_runs(campaign_id) VALUES($1)", job.campaign)
+	must(t, err)
+	_, err = db.Exec(`
+		INSERT INTO warpdrive_delivery_recipients(id,campaign_id,subscriber_id,subscriber_uuid,address_digest,
+		    state,lease_token,lease_until,message_id,attempts)
+		SELECT $1,$2,id,uuid,sha256(convert_to(email,'UTF8')),$4,
+		       CASE WHEN $4='submitting' THEN gen_random_uuid() END,
+		       CASE WHEN $4='submitting' THEN NOW()+INTERVAL '1 minute' END,
+		       '<fixture@example.test>',1 FROM subscribers WHERE id=$3
+	`, job.delivery, job.campaign, job.subscriber, state)
+	must(t, err)
+	return job
+}
+
+func (f *signedFixture) event(job testJob, email, kind, providerID string, age time.Duration) envelope {
+	now := time.Now().Add(-age).UTC()
+	eventType := "Bounce"
+	detail := map[string]any{
+		"bounce": map[string]any{"bounceType": kind, "timestamp": now,
+			"bouncedRecipients": []recipient{{Address: email}}},
+	}
+	if kind == "Complaint" {
+		eventType = kind
+		detail = map[string]any{"complaint": map[string]any{"timestamp": now,
+			"complainedRecipients": []recipient{{Address: ""}}}}
+	}
+	detail["eventType"] = eventType
+	detail["mail"] = map[string]any{"messageId": providerID, "sendingAccountId": "123456789012",
+		"sourceArn":   "arn:aws:ses:us-east-1:123456789012:identity/example.test",
+		"destination": []string{email}, "tags": map[string][]string{
+			"ses:configuration-set": {testSet}, "warpdrive_delivery": {job.delivery},
+		}}
+	raw, err := json.Marshal(detail)
+	must(f.t, err)
+	return f.sign(f.envelope(string(raw)))
+}
+
+func checkValue(t *testing.T, db *sqlx.DB, want any, query string, args ...any) {
+	t.Helper()
+	switch target := want.(type) {
+	case int:
+		var actual int
+		must(t, db.Get(&actual, query, args...))
+		if actual != target {
+			t.Fatalf("got %d, want %d", actual, target)
+		}
+	case string:
+		var actual string
+		must(t, db.Get(&actual, query, args...))
+		if actual != target {
+			t.Fatalf("got %s, want %s", actual, target)
+		}
+	case bool:
+		var actual bool
+		must(t, db.Get(&actual, query, args...))
+		if actual != target {
+			t.Fatalf("got %t, want %t", actual, target)
+		}
+	default:
+		t.Fatal("unexpected fixture assertion type")
+	}
+}
