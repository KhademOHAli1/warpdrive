+func TestSignedSESFeedbackWithPostgres(t *testing.T) {
+	dsn := os.Getenv("WARPDRIVE_SES_FIXTURE_DSN")
+	if dsn == "" {
+		t.Skip("disposable PostgreSQL fixture not requested")
+	}
+	if !strings.HasPrefix(dsn, "host=/tmp/lm-ses-") || !strings.Contains(dsn, "dbname=consent user=consentproof sslmode=disable") {
+		t.Fatal("use the disposable fixture runner")
+	}
+	db, err := sqlx.Connect("postgres", dsn)
+	must(t, err)
+	defer db.Close()
+	f := newSignedFixture(t)
+	h := &handler{db: db, config: f.verification.config, verify: f.verification, log: log.New(io.Discard, "", 0)}
+
+	job := seedJob(t, db, "bounce@example.test", "submitting")
+	hard := f.event(job, job.email, "Permanent", "provider-first", 0)
+	repeat := hard
+	repeat.MessageID = randomID()
+	repeat = f.sign(repeat)
+	statuses := make(chan int, 3)
+	for _, event := range []envelope{hard, hard, repeat} {
+		go func() { statuses <- requestStatus(h, event) }()
+	}
+	for range 3 {
+		if status := <-statuses; status != http.StatusNoContent {
+			t.Fatalf("valid/concurrent feedback returned %d", status)
+		}
+	}
+	checkValue(t, db, 2, "SELECT COUNT(*) FROM warpdrive_ses_feedback WHERE delivery_id=$1", job.delivery)
+	checkValue(t, db, 1, "SELECT COUNT(*) FROM bounces WHERE campaign_id=$1", job.campaign)
+	checkValue(t, db, 1, "SELECT sent FROM campaigns WHERE id=$1", job.campaign)
+	checkValue(t, db, "blocklisted", "SELECT status FROM subscribers WHERE id=$1", job.subscriber)
+	checkValue(t, db, true, `SELECT state='accepted' AND ses_message_id='provider-first' AND smtp_accepted_at IS NULL
+		FROM warpdrive_delivery_recipients WHERE id=$1`, job.delivery)
+	checkValue(t, db, true, "SELECT EXISTS (SELECT 1 FROM warpdrive_crm_suppressions WHERE address_digest=warpdrive_crm_address_digest($1))", job.email)
+
+	stale := seedJob(t, db, "old@example.test", "accepted")
+	_, err = db.Exec("UPDATE subscribers SET email='new@example.test' WHERE id=$1", stale.subscriber)
+	must(t, err)
+	late := f.event(stale, stale.email, "Complaint", "provider-late", 10*24*time.Hour)
+	if status := requestStatus(h, late); status != http.StatusNoContent {
+		t.Fatalf("late signed complaint returned %d", status)
+	}
+	checkValue(t, db, "enabled", "SELECT status FROM subscribers WHERE id=$1", stale.subscriber)
+	checkValue(t, db, "stale", "SELECT outcome FROM warpdrive_ses_feedback WHERE sns_id=$1", late.MessageID)
+	checkValue(t, db, true, "SELECT EXISTS (SELECT 1 FROM warpdrive_crm_suppressions WHERE address_digest=warpdrive_crm_address_digest($1))", stale.email)
+
+	mismatch := seedJob(t, db, "true-envelope@example.test", "unknown")
+	wrong := f.event(mismatch, "different-envelope@example.test", "Complaint", "provider-wrong", 0)
+	if status := requestStatus(h, wrong); status != http.StatusNoContent {
+		t.Fatalf("well-formed unmatched feedback returned %d", status)
+	}
+	checkValue(t, db, "unknown", "SELECT state FROM warpdrive_delivery_recipients WHERE id=$1", mismatch.delivery)
+	checkValue(t, db, "unmatched", "SELECT outcome FROM warpdrive_ses_feedback WHERE sns_id=$1", wrong.MessageID)
+	forged := f.event(mismatch, mismatch.email, "Complaint", "provider-forged", 0)
+	forged.Message += " "
+	if status := requestStatus(h, forged); status != http.StatusForbidden {
+		t.Fatalf("forged feedback returned %d", status)
+	}
+	checkValue(t, db, 0, "SELECT COUNT(*) FROM warpdrive_ses_feedback WHERE sns_id=$1", forged.MessageID)
+
+	temporary := seedJob(t, db, "soft@example.test", "accepted")
+	soft := f.event(temporary, temporary.email, "Transient", "provider-soft", 0)
+	if status := requestStatus(h, soft); status != http.StatusNoContent {
+		t.Fatalf("soft feedback returned %d", status)
+	}
+	checkValue(t, db, "enabled", "SELECT status FROM subscribers WHERE id=$1", temporary.subscriber)
+	checkValue(t, db, "soft", "SELECT type FROM bounces WHERE campaign_id=$1", temporary.campaign)
+
+	retry := seedJob(t, db, "retry-feedback@example.test", "unknown")
+	_, err = db.Exec(fmt.Sprintf(`
+		CREATE FUNCTION reject_synthetic_bounce() RETURNS trigger LANGUAGE plpgsql AS $$
+		BEGIN RAISE EXCEPTION 'fixture rejects first event'; END;
+		$$;
+		CREATE TRIGGER reject_synthetic_bounce BEFORE INSERT ON bounces FOR EACH ROW
+		WHEN (NEW.campaign_id=%d) EXECUTE FUNCTION reject_synthetic_bounce();
+	`, retry.campaign))
+	must(t, err)
+	retriable := f.event(retry, retry.email, "Permanent", "provider-retry", 0)
+	if status := requestStatus(h, retriable); status != http.StatusServiceUnavailable {
+		t.Fatalf("database failure returned %d", status)
+	}
+	checkValue(t, db, 0, "SELECT COUNT(*) FROM warpdrive_ses_feedback WHERE sns_id=$1", retriable.MessageID)
+	checkValue(t, db, "enabled", "SELECT status FROM subscribers WHERE id=$1", retry.subscriber)
+	checkValue(t, db, "unknown", "SELECT state FROM warpdrive_delivery_recipients WHERE id=$1", retry.delivery)
+	_, err = db.Exec("DROP TRIGGER reject_synthetic_bounce ON bounces")
+	must(t, err)
+	if status := requestStatus(h, retriable); status != http.StatusNoContent {
+		t.Fatalf("SNS retry returned %d", status)
+	}
+	checkValue(t, db, "blocklisted", "SELECT status FROM subscribers WHERE id=$1", retry.subscriber)
+	checkValue(t, db, 1, "SELECT sent FROM campaigns WHERE id=$1", retry.campaign)
+}
