index 0000000..8e70908
--- /dev/null
+++ b/internal/sesfeedback/sns.go
@@ -0,0 +1,267 @@
+package sesfeedback
+
+import (
+	"context"
+	"crypto"
+	"crypto/rsa"
+	"crypto/sha256"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/pem"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"os"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/gofrs/uuid/v5"
+)
+
+var (
+	topicPattern    = regexp.MustCompile(`^arn:aws:sns:([a-z]{2}(?:-[a-z0-9]+)+-[0-9]+):([0-9]{12}):[A-Za-z0-9_-]{1,256}$`)
+	setPattern      = regexp.MustCompile(`^[A-Za-z0-9_-]{1,64}$`)
+	certificatePath = regexp.MustCompile(`^/SimpleNotificationService-[a-fA-F0-9]{32,64}\.pem$`)
+	tokenPattern    = regexp.MustCompile(`^[a-zA-Z0-9_-]+$`)
+	ErrDenied       = errors.New("SNS authentication rejected")
+	ErrUnavailable  = errors.New("SNS verification temporarily unavailable")
+)
+
+type Config struct {
+	TopicARN         string
+	ConfigurationSet string
+	Region           string
+	Account          string
+}
+
+func (c Config) Enabled() bool    { return c.TopicARN != "" }
+func (c Config) SMTPHost() string { return "email-smtp." + c.Region + ".amazonaws.com" }
+func (c Config) snsHost() string  { return "sns." + c.Region + ".amazonaws.com" }
+
+func ParseConfig(topic, set string) (Config, error) {
+	parts := topicPattern.FindStringSubmatch(topic)
+	if len(parts) == 0 || !setPattern.MatchString(set) {
+		return Config{}, errors.New("invalid SNS topic ARN or SES configuration set")
+	}
+	return Config{TopicARN: topic, ConfigurationSet: set, Region: parts[1], Account: parts[2]}, nil
+}
+
+var ConfigFromEnv = sync.OnceValues(func() (Config, error) {
+	if os.Getenv("NEWSLETTER_SES_FEEDBACK_ENABLED") != "true" {
+		return Config{}, nil
+	}
+	return ParseConfig(os.Getenv("NEWSLETTER_SES_TOPIC_ARN"), os.Getenv("NEWSLETTER_SES_CONFIGURATION_SET"))
+})
+
+type envelope struct {
+	Type             string
+	MessageID        string `json:"MessageId"`
+	TopicARN         string `json:"TopicArn"`
+	Subject          *string
+	Message          string
+	Timestamp        string
+	SignatureVersion string
+	Signature        string
+	SigningCertURL   string
+	SubscribeURL     string
+	Token            string
+}
+
+func (e envelope) canonical() string {
+	var content strings.Builder
+	appendField := func(key, value string) {
+		content.WriteString(key)
+		content.WriteByte('\n')
+		content.WriteString(value)
+		content.WriteByte('\n')
+	}
+	appendField("Message", e.Message)
+	appendField("MessageId", e.MessageID)
+	if e.Type == "Notification" && e.Subject != nil {
+		appendField("Subject", *e.Subject)
+	}
+	if e.Type != "Notification" {
+		appendField("SubscribeURL", e.SubscribeURL)
+	}
+	appendField("Timestamp", e.Timestamp)
+	if e.Type != "Notification" {
+		appendField("Token", e.Token)
+	}
+	appendField("TopicArn", e.TopicARN)
+	appendField("Type", e.Type)
+	return content.String()
+}
+
+type verifier struct {
+	config       Config
+	client       *http.Client
+	mu           sync.Mutex
+	certificates map[string]*x509.Certificate
+	fetchSlots   chan struct{}
+}
+
+func newVerifier(config Config) *verifier {
+	return &verifier{
+		config: config,
+		client: &http.Client{
+			Timeout:       5 * time.Second,
+			CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse },
+			Transport: &http.Transport{
+				DialContext:     (&net.Dialer{Timeout: 3 * time.Second}).DialContext,
+				MaxConnsPerHost: 4,
+				IdleConnTimeout: 30 * time.Second,
+				TLSClientConfig: &tls.Config{MinVersion: tls.VersionTLS12},
+			},
+		},
+		certificates: make(map[string]*x509.Certificate),
+		fetchSlots:   make(chan struct{}, 4),
+	}
+}
+
+func (v *verifier) verify(ctx context.Context, message envelope, headers http.Header) error {
+	if message.TopicARN != v.config.TopicARN || message.SignatureVersion != "2" || message.Message == "" {
+		return ErrDenied
+	}
+	switch message.Type {
+	case "Notification", "SubscriptionConfirmation", "UnsubscribeConfirmation":
+	default:
+		return ErrDenied
+	}
+	for field, value := range map[string]string{
+		"X-Amz-Sns-Message-Type": message.Type, "X-Amz-Sns-Message-Id": message.MessageID,
+		"X-Amz-Sns-Topic-Arn": message.TopicARN,
+	} {
+		if headers.Get(field) != value {
+			return ErrDenied
+		}
+	}
+	if _, err := uuid.FromString(message.MessageID); err != nil {
+		return ErrDenied
+	}
+	stamp, err := time.Parse(time.RFC3339Nano, message.Timestamp)
+	if err != nil || stamp.After(time.Now().Add(5*time.Minute)) {
+		return ErrDenied
+	}
+	if message.Subject != nil && strings.ContainsAny(*message.Subject, "\r\n") {
+		return ErrDenied
+	}
+	if message.Type != "Notification" && (message.SubscribeURL == "" || strings.ContainsAny(message.SubscribeURL, "\r\n") ||
+		len(message.Token) < 16 || len(message.Token) > 2048 || !tokenPattern.MatchString(message.Token)) {
+		return ErrDenied
+	}
+	signature, err := base64.StdEncoding.Strict().DecodeString(message.Signature)
+	if err != nil || len(signature) < 256 || len(signature) > 1024 {
+		return ErrDenied
+	}
+	certURL, err := v.parseSNSURL(message.SigningCertURL)
+	if err != nil || certURL.RawQuery != "" || certURL.ForceQuery || !certificatePath.MatchString(certURL.Path) {
+		return ErrDenied
+	}
+	certificate, err := v.getCertificate(ctx, certURL)
+	if err != nil {
+		return err
+	}
+	key, ok := certificate.PublicKey.(*rsa.PublicKey)
+	if !ok || key.N.BitLen() < 2048 || stamp.Before(certificate.NotBefore) || stamp.After(certificate.NotAfter) ||
+		(certificate.KeyUsage != 0 && certificate.KeyUsage&x509.KeyUsageDigitalSignature == 0) {
+		return ErrDenied
+	}
+	digest := sha256.Sum256([]byte(message.canonical()))
+	if rsa.VerifyPKCS1v15(key, crypto.SHA256, digest[:], signature) != nil {
+		return ErrDenied
+	}
+	return nil
+}
+
+func (v *verifier) parseSNSURL(raw string) (*url.URL, error) {
+	u, err := url.Parse(raw)
+	if err != nil || u.Scheme != "https" || u.Host != v.config.snsHost() || u.User != nil ||
+		u.Opaque != "" || u.Fragment != "" || u.RawPath != "" || strings.Contains(raw, "#") {
+		return nil, ErrDenied
+	}
+	return u, nil
+}
+
+func (v *verifier) getCertificate(ctx context.Context, u *url.URL) (*x509.Certificate, error) {
+	key := u.String()
+	v.mu.Lock()
+	certificate := v.certificates[key]
+	v.mu.Unlock()
+	if certificate != nil {
+		return certificate, nil
+	}
+
+	select {
+	case v.fetchSlots <- struct{}{}:
+		defer func() { <-v.fetchSlots }()
+	default:
+		return nil, ErrUnavailable
+	}
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, key, nil)
+	if err != nil {
+		return nil, ErrDenied
+	}
+	// The platform trust store verifies the HTTPS chain for the exact regional
+	// SNS service. Only the AWS-controlled signing certificate path is accepted.
+	response, err := v.client.Do(request)
+	if err != nil {
+		return nil, ErrUnavailable
+	}
+	defer response.Body.Close()
+	if response.StatusCode == 429 || response.StatusCode >= 500 {
+		return nil, ErrUnavailable
+	}
+	if response.StatusCode != 200 {
+		return nil, ErrDenied
+	}
+	raw, err := io.ReadAll(io.LimitReader(response.Body, (32<<10)+1))
+	if err != nil {
+		return nil, ErrUnavailable
+	}
+	block, _ := pem.Decode(raw)
+	if len(raw) > 32<<10 || block == nil || block.Type != "CERTIFICATE" {
+		return nil, ErrDenied
+	}
+	certificate, err = x509.ParseCertificate(block.Bytes)
+	if err != nil {
+		return nil, ErrDenied
+	}
+	v.mu.Lock()
+	if len(v.certificates) >= 8 {
+		clear(v.certificates)
+	}
+	v.certificates[key] = certificate
+	v.mu.Unlock()
+	return certificate, nil
+}
+
+func (v *verifier) confirm(ctx context.Context, message envelope) error {
+	u, err := v.parseSNSURL(message.SubscribeURL)
+	if err != nil || u.Path != "/" {
+		return ErrDenied
+	}
+	query, err := url.ParseQuery(u.RawQuery)
+	if err != nil || len(query) != 3 || len(query["Action"]) != 1 || len(query["TopicArn"]) != 1 ||
+		len(query["Token"]) != 1 || query.Get("Action") != "ConfirmSubscription" ||
+		query.Get("TopicArn") != v.config.TopicARN || query.Get("Token") != message.Token {
+		return ErrDenied
+	}
+	request, err := http.NewRequestWithContext(ctx, http.MethodGet, u.String(), nil)
+	if err != nil {
+		return ErrDenied
+	}
+	response, err := v.client.Do(request)
+	if err != nil {
+		return ErrUnavailable
+	}
+	defer response.Body.Close()
+	if response.StatusCode < 200 || response.StatusCode >= 300 {
+		return ErrUnavailable
+	}
+	return nil
+}
