diff --git a/internal/sesfeedback/feedback.go b/internal/sesfeedback/feedback.go
new file mode 100644
index 0000000..d926a26
--- /dev/null
+++ b/internal/sesfeedback/feedback.go
@@ -0,0 +1,372 @@
+package sesfeedback
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"database/sql"
+	_ "embed"
+	"encoding/json"
+	"errors"
+	"io"
+	"log"
+	"net/http"
+	"net/mail"
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/gofrs/uuid/v5"
+	"github.com/jmoiron/sqlx"
+)
+
+//go:embed schema.sql
+var schema string
+
+const maxEventBytes = 1 << 20
+
+var (
+	messageIDPattern = regexp.MustCompile(`^[A-Za-z0-9._-]{1,128}$`)
+	errUnexpected    = errors.New("unexpected SES feedback")
+)
+
+type feedback struct {
+	topic, snsID string
+	deliveryID   string
+	messageID    string
+	email        string
+	kind         string
+	timestamp    time.Time
+}
+
+type recipient struct {
+	Address string `json:"emailAddress"`
+}
+
+func parseFeedback(config Config, sns envelope) (feedback, error) {
+	var event struct {
+		EventType string
+		Mail      struct {
+			MessageID        string `json:"messageId"`
+			Destination      []string
+			SendingAccountID string `json:"sendingAccountId"`
+			SourceARN        string `json:"sourceArn"`
+			Tags             map[string][]string
+		}
+		Bounce *struct {
+			BounceType        string
+			Timestamp         time.Time
+			BouncedRecipients []recipient
+		}
+		Complaint *struct {
+			Timestamp            time.Time
+			ComplainedRecipients []recipient
+		}
+	}
+	if json.Unmarshal([]byte(sns.Message), &event) != nil || event.Mail.SendingAccountID != config.Account ||
+		!strings.HasPrefix(event.Mail.SourceARN, "arn:aws:ses:"+config.Region+":"+config.Account+":identity/") ||
+		!messageIDPattern.MatchString(event.Mail.MessageID) || len(event.Mail.Destination) != 1 ||
+		!singleTag(event.Mail.Tags["ses:configuration-set"], config.ConfigurationSet) {
+		return feedback{}, errUnexpected
+	}
+	deliveryTags := event.Mail.Tags["warpdrive_delivery"]
+	if len(deliveryTags) != 1 {
+		return feedback{}, errUnexpected
+	}
+	deliveryID, err := uuid.FromString(deliveryTags[0])
+	if err != nil || deliveryID.String() != deliveryTags[0] {
+		return feedback{}, errUnexpected
+	}
+	email := event.Mail.Destination[0]
+	addr, err := mail.ParseAddress(email)
+	if err != nil || addr.Address != email || len(email) > 320 {
+		return feedback{}, errUnexpected
+	}
+	result := feedback{topic: sns.TopicARN, snsID: sns.MessageID, deliveryID: deliveryID.String(),
+		messageID: event.Mail.MessageID, email: email}
+	switch event.EventType {
+	case "Bounce":
+		if event.Bounce == nil || len(event.Bounce.BouncedRecipients) != 1 ||
+			!strings.EqualFold(event.Bounce.BouncedRecipients[0].Address, email) {
+			return feedback{}, errUnexpected
+		}
+		switch event.Bounce.BounceType {
+		case "Permanent":
+			result.kind = "hard"
+		case "Transient", "Undetermined":
+			result.kind = "soft"
+		default:
+			return feedback{}, errUnexpected
+		}
+		result.timestamp = event.Bounce.Timestamp
+	case "Complaint":
+		if event.Complaint == nil || len(event.Complaint.ComplainedRecipients) > 1 {
+			return feedback{}, errUnexpected
+		}
+		// Some providers redact the complaining address. The signed SES
+		// envelope still names exactly one recipient of this message.
+		if len(event.Complaint.ComplainedRecipients) == 1 {
+			reported := event.Complaint.ComplainedRecipients[0].Address
+			if reported != "" && !strings.EqualFold(reported, email) {
+				return feedback{}, errUnexpected
+			}
+		}
+		result.kind = "complaint"
+		result.timestamp = event.Complaint.Timestamp
+	default:
+		return feedback{}, errUnexpected
+	}
+	envelopeTime, _ := time.Parse(time.RFC3339Nano, sns.Timestamp)
+	if result.timestamp.IsZero() || result.timestamp.After(envelopeTime.Add(5*time.Minute)) {
+		return feedback{}, errUnexpected
+	}
+	return result, nil
+}
+
+func singleTag(tags []string, expected string) bool {
+	return len(tags) == 1 && tags[0] == expected
+}
+
+func Install(db *sqlx.DB) error {
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	tx, err := db.BeginTxx(ctx, nil)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	if _, err := tx.ExecContext(ctx, "SELECT pg_advisory_xact_lock(900731613, 50)"); err != nil {
+		return err
+	}
+	res, err := tx.ExecContext(ctx, "INSERT INTO warpdrive_delivery_migrations(version) VALUES (3) ON CONFLICT DO NOTHING")
+	if err != nil {
+		return err
+	}
+	n, err := res.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if n == 1 {
+		if _, err := tx.ExecContext(ctx, schema); err != nil {
+			return err
+		}
+	}
+	return tx.Commit()
+}
+
+type handler struct {
+	db     *sqlx.DB
+	config Config
+	verify *verifier
+	log    *log.Logger
+}
+
+func NewHandler(db *sqlx.DB, config Config, log *log.Logger) http.Handler {
+	if !config.Enabled() {
+		return http.NotFoundHandler()
+	}
+	return &handler{db: db, config: config, verify: newVerifier(config), log: log}
+}
+
+func (h *handler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	w.Header().Set("Cache-Control", "no-store")
+	if r.Method != http.MethodPost {
+		w.WriteHeader(http.StatusMethodNotAllowed)
+		return
+	}
+	raw, err := io.ReadAll(http.MaxBytesReader(w, r.Body, maxEventBytes))
+	if err != nil {
+		var limit *http.MaxBytesError
+		if errors.As(err, &limit) {
+			w.WriteHeader(http.StatusRequestEntityTooLarge)
+		} else {
+			w.WriteHeader(http.StatusBadRequest)
+		}
+		return
+	}
+	var sns envelope
+	if json.Unmarshal(raw, &sns) != nil {
+		w.WriteHeader(http.StatusBadRequest)
+		return
+	}
+	ctx, cancel := context.WithTimeout(r.Context(), 12*time.Second)
+	defer cancel()
+	if err := h.verify.verify(ctx, sns, r.Header); err != nil {
+		writeVerificationError(w, err)
+		return
+	}
+	if sns.Type != "Notification" {
+		if sns.Type == "SubscriptionConfirmation" {
+			if err := h.verify.confirm(ctx, sns); err != nil {
+				writeVerificationError(w, err)
+				return
+			}
+		}
+		kind := "unsubscribe"
+		if sns.Type == "SubscriptionConfirmation" {
+			kind = "subscription"
+		}
+		_, err = h.db.ExecContext(ctx, `
+			INSERT INTO warpdrive_ses_feedback(topic_arn, sns_id, kind, outcome) VALUES ($1, $2, $3, 'confirmed')
+			ON CONFLICT DO NOTHING
+		`, sns.TopicARN, sns.MessageID, kind)
+	} else {
+		event, parseErr := parseFeedback(h.config, sns)
+		if parseErr != nil {
+			w.WriteHeader(http.StatusBadRequest)
+			return
+		}
+		err = h.persist(ctx, event)
+	}
+	if err != nil {
+		h.log.Print("could not persist SES feedback")
+		w.WriteHeader(http.StatusServiceUnavailable)
+		return
+	}
+	w.WriteHeader(http.StatusNoContent)
+}
+
+func writeVerificationError(w http.ResponseWriter, err error) {
+	if errors.Is(err, ErrUnavailable) {
+		w.WriteHeader(http.StatusServiceUnavailable)
+	} else {
+		w.WriteHeader(http.StatusForbidden)
+	}
+}
+
+func (h *handler) persist(ctx context.Context, event feedback) error {
+	tx, err := h.db.BeginTxx(ctx, nil)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	// A campaign lock serializes SES reconciliation with the sender and other
+	// feedback for the same recipient. A mismatched envelope never changes it.
+	var campaignID int
+	err = tx.GetContext(ctx, &campaignID, `
+		SELECT c.id FROM campaigns c JOIN warpdrive_delivery_recipients d ON d.campaign_id=c.id
+		WHERE d.id=$1 FOR UPDATE OF c
+	`, event.deliveryID)
+	if err != nil && !errors.Is(err, sql.ErrNoRows) {
+		return err
+	}
+	row, err := tx.ExecContext(ctx, `
+		INSERT INTO warpdrive_ses_feedback(topic_arn, sns_id, delivery_id, kind, outcome)
+		VALUES ($1, $2, $3, $4, 'unmatched') ON CONFLICT DO NOTHING
+	`, event.topic, event.snsID, event.deliveryID, event.kind)
+	if err != nil {
+		return err
+	}
+	inserted, err := row.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if campaignID != 0 && inserted == 1 {
+		outcome, err := recordForDelivery(ctx, tx, campaignID, event)
+		if err != nil {
+			return err
+		}
+		if _, err := tx.ExecContext(ctx, "UPDATE warpdrive_ses_feedback SET outcome=$3 WHERE topic_arn=$1 AND sns_id=$2",
+			event.topic, event.snsID, outcome); err != nil {
+			return err
+		}
+	}
+	return tx.Commit()
+}
+
+func recordForDelivery(ctx context.Context, tx *sqlx.Tx, campaignID int, event feedback) (string, error) {
+	var receipt struct {
+		SubscriberID   sql.NullInt64  `db:"subscriber_id"`
+		SubscriberUUID sql.NullString `db:"subscriber_uuid"`
+		AddressDigest  []byte         `db:"address_digest"`
+		SESMessageID   sql.NullString `db:"ses_message_id"`
+		State          string
+	}
+	if err := tx.GetContext(ctx, &receipt, `
+		SELECT subscriber_id, subscriber_uuid, address_digest, ses_message_id, state
+		FROM warpdrive_delivery_recipients WHERE id=$1 AND message_id IS NOT NULL AND attempts>0
+	`, event.deliveryID); err != nil {
+		if errors.Is(err, sql.ErrNoRows) {
+			return "unmatched", nil
+		}
+		return "", err
+	}
+	digest := sha256.Sum256([]byte(event.email))
+	if !receipt.SubscriberID.Valid || !bytes.Equal(receipt.AddressDigest, digest[:]) ||
+		(receipt.SESMessageID.Valid && receipt.SESMessageID.String != event.messageID) {
+		return "unmatched", nil
+	}
+
+	var duplicate bool
+	if err := tx.GetContext(ctx, &duplicate, `
+		SELECT EXISTS (SELECT 1 FROM warpdrive_ses_feedback
+		               WHERE delivery_id=$1 AND kind=$2 AND outcome IN ('stale', 'recorded', 'suppressed'))
+	`, event.deliveryID, event.kind); err != nil {
+		return "", err
+	}
+	if duplicate {
+		return "duplicate", nil
+	}
+
+	suppression := event.kind == "hard" || event.kind == "complaint"
+	if suppression {
+		// The same lock and keyed digest are used by the engine's mailbox
+		// erasure/import fence. The raw address is never written to feedback.
+		if _, err := tx.ExecContext(ctx, "SELECT pg_advisory_xact_lock(hashtextextended(lower($1),416340))", event.email); err != nil {
+			return "", err
+		}
+	}
+	var currentSubscriber int
+	err := tx.GetContext(ctx, &currentSubscriber, `
+		SELECT id FROM subscribers WHERE id=$1 AND uuid=$2 AND email=$3 FOR NO KEY UPDATE
+	`, receipt.SubscriberID, receipt.SubscriberUUID, event.email)
+	if err != nil && !errors.Is(err, sql.ErrNoRows) {
+		return "", err
+	}
+
+	// Erasure can anonymize the receipt while the subscriber lock is acquired.
+	update, err := tx.ExecContext(ctx, `
+		UPDATE warpdrive_delivery_recipients SET ses_message_id=$2, state='accepted',
+		    lease_token=NULL, lease_until=NULL, updated_at=NOW()
+		WHERE id=$1 AND address_digest=$3
+	`, event.deliveryID, event.messageID, digest[:])
+	if err != nil {
+		return "", err
+	}
+	count, err := update.RowsAffected()
+	if err != nil {
+		return "", err
+	}
+	if count == 0 {
+		return "unmatched", nil
+	}
+	if receipt.State != "accepted" {
+		if _, err := tx.ExecContext(ctx, "UPDATE campaigns SET sent=sent+1, updated_at=NOW() WHERE id=$1", campaignID); err != nil {
+			return "", err
+		}
+	}
+	if suppression {
+		if _, err := tx.ExecContext(ctx, `
+			INSERT INTO warpdrive_crm_suppressions(address_digest) VALUES(warpdrive_crm_address_digest($1))
+			ON CONFLICT DO NOTHING
+		`, event.email); err != nil {
+			return "", err
+		}
+	}
+	if currentSubscriber == 0 {
+		return "stale", nil
+	}
+	if _, err := tx.ExecContext(ctx, `
+		INSERT INTO bounces(subscriber_id, campaign_id, type, source, created_at) VALUES ($1, $2, $3, 'ses', $4)
+	`, currentSubscriber, campaignID, event.kind, event.timestamp); err != nil {
+		return "", err
+	}
+	if suppression {
+		if _, err := tx.ExecContext(ctx, "UPDATE subscribers SET status='blocklisted', updated_at=NOW() WHERE id=$1",
+			currentSubscriber); err != nil {
+			return "", err
+		}
+		return "suppressed", nil
+	}
+	return "recorded", nil
+}
