diff --git a/internal/messenger/email/warpdrive_delivery.go b/internal/messenger/email/warpdrive_delivery.go
new file mode 100644
index 0000000..3ab13e4
--- /dev/null
+++ b/internal/messenger/email/warpdrive_delivery.go
@@ -0,0 +1,140 @@
+package email
+
+import (
+	"context"
+	"crypto/tls"
+	"errors"
+	"net"
+	"net/mail"
+	"net/smtp"
+	"net/textproto"
+	"strconv"
+	"time"
+
+	"github.com/knadh/listmonk/models"
+	"github.com/knadh/smtppool/v2"
+)
+
+const campaignSMTPTimeout = 30 * time.Second
+
+// PushCampaignDelivery attempts exactly one SMTP transaction. A lost DATA
+// response is ambiguous and may never trigger a transport-level retry.
+func (e *Emailer) PushCampaignDelivery(message models.Message) models.DeliveryOutcome {
+	server, envelope := e.prepareMessage(message)
+	envelope.Headers.Del(hdrBcc)
+	envelope.Headers.Del(hdrCc)
+	envelope.Bcc, envelope.Cc = nil, nil
+	return sendCampaignDelivery(server, envelope)
+}
+
+func sendCampaignDelivery(server *Server, message smtppool.Email) models.DeliveryOutcome {
+	if len(message.To) != 1 {
+		return models.DeliveryRejected
+	}
+	recipient, err := mail.ParseAddress(message.To[0])
+	if err != nil {
+		return models.DeliveryRejected
+	}
+	senderValue := message.Sender
+	if senderValue == "" {
+		senderValue = message.From
+	}
+	sender, err := mail.ParseAddress(senderValue)
+	if err != nil {
+		return models.DeliveryRejected
+	}
+	payload, err := message.Bytes()
+	if err != nil {
+		return models.DeliveryRejected
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), campaignSMTPTimeout)
+	defer cancel()
+	select {
+	case server.campaignSlots <- struct{}{}:
+		defer func() { <-server.campaignSlots }()
+	case <-ctx.Done():
+		return models.DeliveryRetry
+	}
+
+	addr := net.JoinHostPort(server.Host, strconv.Itoa(server.Port))
+	dialer := net.Dialer{Timeout: server.PoolWaitTimeout}
+	conn, err := dialer.DialContext(ctx, "tcp", addr)
+	if err != nil {
+		return models.DeliveryRetry
+	}
+	defer conn.Close()
+	deadline, _ := ctx.Deadline()
+	if err := conn.SetDeadline(deadline); err != nil {
+		return models.DeliveryRetry
+	}
+	if server.SSL == smtppool.SSLTLS {
+		secured := tls.Client(conn, server.TLSConfig)
+		if err := secured.HandshakeContext(ctx); err != nil {
+			return models.DeliveryRetry
+		}
+		conn = secured
+	}
+
+	client, err := smtp.NewClient(conn, server.Host)
+	if err != nil {
+		return beforeData(err)
+	}
+	defer client.Close()
+	if server.HelloHostname != "" {
+		if err := client.Hello(server.HelloHostname); err != nil {
+			return beforeData(err)
+		}
+	}
+	if server.SSL == smtppool.SSLSTARTTLS {
+		if err := client.StartTLS(server.TLSConfig); err != nil {
+			return beforeData(err)
+		}
+	}
+	if server.Auth != nil {
+		if err := client.Auth(server.Auth); err != nil {
+			return beforeData(err)
+		}
+	}
+	if err := client.Mail(sender.Address); err != nil {
+		return beforeData(err)
+	}
+	if err := client.Rcpt(recipient.Address); err != nil {
+		return beforeData(err)
+	}
+	body, err := client.Data()
+	if err != nil {
+		return beforeData(err)
+	}
+	if _, err := body.Write(payload); err != nil {
+		// Close the connection, never the DATA writer, after a failed write.
+		return models.DeliveryUnknown
+	}
+	if err := body.Close(); err != nil {
+		if status, ok := smtpStatus(err); ok {
+			return status
+		}
+		return models.DeliveryUnknown
+	}
+	return models.DeliveryAccepted
+}
+
+func beforeData(err error) models.DeliveryOutcome {
+	if status, ok := smtpStatus(err); ok {
+		return status
+	}
+	return models.DeliveryRetry
+}
+
+func smtpStatus(err error) (models.DeliveryOutcome, bool) {
+	var reply *textproto.Error
+	if errors.As(err, &reply) {
+		switch reply.Code / 100 {
+		case 4:
+			return models.DeliveryRetry, true
+		case 5:
+			return models.DeliveryRejected, true
+		}
+	}
+	return models.DeliveryUnknown, false
+}
