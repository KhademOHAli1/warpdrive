diff --git a/internal/manager/warpdrive_delivery.go b/internal/manager/warpdrive_delivery.go
new file mode 100644
index 0000000..a5f6763
--- /dev/null
+++ b/internal/manager/warpdrive_delivery.go
@@ -0,0 +1,94 @@
+package manager
+
+import (
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"net/mail"
+	"slices"
+	"strings"
+
+	"github.com/knadh/listmonk/models"
+)
+
+type deliveryMessenger interface {
+	PushCampaignDelivery(models.Message) models.DeliveryOutcome
+}
+
+// deliveryRevision keeps a restart from silently switching shared template or
+// media bytes for the recipients still pending in this run.
+func deliveryRevision(c *models.Campaign, body, templateBody string, config Config) ([]byte, error) {
+	attachments := make([]string, 0, len(c.Attachments))
+	for _, file := range c.Attachments {
+		attachments = append(attachments, fmt.Sprintf("%s:%s:%x", file.Name, file.Header.Get("Content-Type"), sha256.Sum256(file.Content)))
+	}
+	slices.Sort(attachments)
+	revision, err := json.Marshal(struct {
+		CampaignFields  []string
+		Headers         models.Headers
+		Attributes      models.JSON
+		Attachments     []string
+		TrackingOptions []bool
+		PublicURLs      []string
+	}{
+		CampaignFields:  []string{c.Type, c.UUID, c.Name, c.Subject, c.FromEmail, c.Messenger, c.ContentType, body, templateBody, c.AltBody.String},
+		Headers:         c.Headers,
+		Attributes:      c.Attribs,
+		Attachments:     attachments,
+		TrackingOptions: []bool{config.DisableTracking, config.IndividualTracking, config.UnsubHeader},
+		PublicURLs:      []string{config.RootURL, config.UnsubURL, config.OptinURL, config.LinkTrackURL, config.ViewTrackURL, config.MessageURL, config.ArchiveURL},
+	})
+	if err != nil {
+		return nil, err
+	}
+	digest := sha256.Sum256(revision)
+	return digest[:], nil
+}
+
+func (m *Manager) releaseCampaignLease(msg CampaignMessage, reject bool) {
+	if err := m.store.ReleaseDelivery(msg.Campaign.ID, msg.lease, reject); err != nil {
+		m.log.Printf("error releasing delivery %s for campaign %d", msg.lease.DeliveryID, msg.Campaign.ID)
+	}
+}
+
+func (m *Manager) dispatchCampaignDelivery(msg CampaignMessage, out models.Message) {
+	if msg.pipe.stopped.Load() {
+		m.releaseCampaignLease(msg, false)
+		return
+	}
+	from, err := mail.ParseAddress(out.From)
+	if err != nil {
+		m.releaseCampaignLease(msg, true)
+		msg.pipe.OnError()
+		return
+	}
+	domain := from.Address[strings.LastIndexByte(from.Address, '@')+1:]
+	messageID := "<warpdrive-" + msg.lease.DeliveryID + "@" + domain + ">"
+	started, err := m.store.BeginDelivery(msg.Campaign.ID, msg.lease, messageID)
+	if err != nil {
+		// The commit may have succeeded. Do not send without a confirmed lease.
+		m.log.Printf("could not authorize delivery %s for campaign %d", msg.lease.DeliveryID, msg.Campaign.ID)
+		msg.pipe.Stop(true)
+		return
+	}
+	if !started {
+		return
+	}
+
+	out.Headers.Set("Message-ID", messageID)
+	transport := m.messengers[msg.Campaign.Messenger].(deliveryMessenger)
+	state, err := m.store.FinishDelivery(msg.Campaign.ID, msg.lease, transport.PushCampaignDelivery(out))
+	if err != nil {
+		m.log.Printf("could not persist delivery %s for campaign %d", msg.lease.DeliveryID, msg.Campaign.ID)
+		msg.pipe.Stop(true)
+		return
+	}
+	switch state {
+	case "accepted":
+		msg.pipe.rate.Incr(1)
+	case "rejected":
+		msg.pipe.OnError()
+	case "unknown":
+		msg.pipe.Stop(false)
+	}
+}
