+package models
+
+// DeliveryLease is one fenced claim on a persisted campaign recipient.
+type DeliveryLease struct {
+	Subscriber
+	DeliveryID string `db:"delivery_id"`
+	LeaseToken string `db:"lease_token"`
+}
+
+type DeliveryOutcome string
+
+const (
+	DeliveryAccepted DeliveryOutcome = "accepted"
+	DeliveryRetry    DeliveryOutcome = "retry"
+	DeliveryRejected DeliveryOutcome = "rejected"
+	DeliveryUnknown  DeliveryOutcome = "unknown"
+)
