diff --git a/cmd/warpdrive_delivery.sql b/cmd/warpdrive_delivery.sql
new file mode 100644
index 0000000..297cb07
--- /dev/null
+++ b/cmd/warpdrive_delivery.sql
@@ -0,0 +1,61 @@
+CREATE TABLE IF NOT EXISTS warpdrive_delivery_runs (
+    campaign_id INTEGER PRIMARY KEY REFERENCES campaigns(id) ON DELETE CASCADE,
+    revision BYTEA,
+    recipient_ceiling INTEGER NOT NULL DEFAULT 0,
+    exhausted BOOLEAN NOT NULL DEFAULT FALSE,
+    hold TEXT NOT NULL DEFAULT '' CHECK (hold IN ('', 'legacy', 'revision_changed'))
+);
+
+CREATE TABLE IF NOT EXISTS warpdrive_delivery_recipients (
+    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
+    campaign_id INTEGER NOT NULL REFERENCES warpdrive_delivery_runs(campaign_id) ON DELETE CASCADE,
+    subscriber_id INTEGER REFERENCES subscribers(id) ON DELETE SET NULL,
+    subscriber_uuid UUID,
+    address_digest BYTEA,
+    state TEXT NOT NULL DEFAULT 'pending'
+        CHECK (state IN ('pending', 'leased', 'submitting', 'accepted', 'rejected', 'unknown', 'suppressed')),
+    available_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+    lease_token UUID,
+    lease_until TIMESTAMPTZ,
+    message_id TEXT,
+    attempts INTEGER NOT NULL DEFAULT 0 CHECK (attempts BETWEEN 0 AND 3),
+    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+    UNIQUE (campaign_id, subscriber_id),
+    CHECK ((state IN ('leased', 'submitting')) = (lease_token IS NOT NULL AND lease_until IS NOT NULL)),
+    CHECK ((subscriber_id IS NULL AND subscriber_uuid IS NULL AND address_digest IS NULL)
+        OR (subscriber_id IS NOT NULL AND subscriber_uuid IS NOT NULL AND address_digest IS NOT NULL))
+);
+
+CREATE OR REPLACE FUNCTION warpdrive_delivery_anonymize_recipient() RETURNS TRIGGER LANGUAGE plpgsql AS $$
+BEGIN
+    NEW.subscriber_uuid := NULL;
+    NEW.address_digest := NULL;
+    IF NEW.state IN ('pending', 'leased') THEN
+        NEW.state := 'suppressed';
+        NEW.lease_token := NULL;
+        NEW.lease_until := NULL;
+    END IF;
+    NEW.updated_at := NOW();
+    RETURN NEW;
+END;
+$$;
+
+CREATE OR REPLACE TRIGGER warpdrive_delivery_anonymize_recipient
+    BEFORE UPDATE OF subscriber_id ON warpdrive_delivery_recipients
+    FOR EACH ROW WHEN (OLD.subscriber_id IS NOT NULL AND NEW.subscriber_id IS NULL)
+    EXECUTE FUNCTION warpdrive_delivery_anonymize_recipient();
+
+CREATE INDEX IF NOT EXISTS warpdrive_delivery_subscriber
+    ON warpdrive_delivery_recipients (subscriber_id) WHERE subscriber_id IS NOT NULL;
+CREATE INDEX IF NOT EXISTS warpdrive_delivery_ready
+    ON warpdrive_delivery_recipients (campaign_id, available_at, subscriber_id)
+    WHERE state = 'pending';
+CREATE INDEX IF NOT EXISTS warpdrive_delivery_active
+    ON warpdrive_delivery_recipients (campaign_id, lease_until)
+    WHERE state IN ('leased', 'submitting');
+CREATE INDEX IF NOT EXISTS warpdrive_delivery_outstanding
+    ON warpdrive_delivery_recipients (campaign_id)
+    WHERE state IN ('pending', 'leased', 'submitting');
+CREATE INDEX IF NOT EXISTS warpdrive_delivery_unknown
+    ON warpdrive_delivery_recipients (campaign_id, updated_at, id)
+    WHERE state = 'unknown';
diff --git a/cmd/warpdrive_delivery_http.go b/cmd/warpdrive_delivery_http.go
new file mode 100644
index 0000000..64136eb
--- /dev/null
+++ b/cmd/warpdrive_delivery_http.go
@@ -0,0 +1,118 @@
+package main
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"net/http"
+
+	"github.com/gofrs/uuid/v5"
+	"github.com/jmoiron/sqlx"
+	"github.com/knadh/listmonk/internal/auth"
+	"github.com/labstack/echo/v4"
+)
+
+type deliveryState struct {
+	Hold   string          `db:"hold" json:"hold"`
+	Counts json.RawMessage `db:"counts" json:"counts"`
+	Review json.RawMessage `db:"review" json:"review"`
+}
+
+func (a *App) GetWarpdriveDelivery(c echo.Context) error {
+	id := getID(c)
+	if err := a.checkCampaignPerm(auth.PermTypeGet, id, c); err != nil {
+		return err
+	}
+	ctx, cancel := context.WithTimeout(c.Request().Context(), deliveryDBTimeout)
+	defer cancel()
+	var status deliveryState
+	if err := a.db.GetContext(ctx, &status, `
+		WITH projected AS MATERIALIZED (
+			SELECT id, message_id, attempts, updated_at,
+			       CASE WHEN state = 'submitting' AND lease_until <= clock_timestamp() THEN 'unknown' ELSE state END AS state
+			FROM warpdrive_delivery_recipients WHERE campaign_id = $1
+		), counters AS (
+			SELECT state, COUNT(*) AS count FROM projected GROUP BY state
+		)
+		SELECT COALESCE((SELECT hold FROM warpdrive_delivery_runs WHERE campaign_id = $1), '') AS hold,
+		       COALESCE((SELECT jsonb_object_agg(state, count) FROM counters), '{}'::jsonb) AS counts,
+		       COALESCE((SELECT jsonb_agg(to_jsonb(r)) FROM (
+		           SELECT id, message_id, attempts, updated_at FROM projected
+		           WHERE state = 'unknown' ORDER BY updated_at, id LIMIT 100
+		       ) AS r), '[]'::jsonb) AS review
+	`, id); err != nil {
+		a.log.Printf("could not read delivery receipts for campaign %d: %v", id, err)
+		return echo.NewHTTPError(http.StatusInternalServerError)
+	}
+	return c.JSON(http.StatusOK, okResp{status})
+}
+
+func (a *App) ResolveWarpdriveDelivery(c echo.Context) error {
+	id := getID(c)
+	if err := a.checkCampaignPerm(auth.PermTypeManage, id, c); err != nil {
+		return err
+	}
+	var req struct {
+		DeliveryID string `json:"delivery_id"`
+		Outcome    string `json:"outcome"`
+	}
+	if err := c.Bind(&req); err != nil {
+		return err
+	}
+	deliveryID, err := uuid.FromString(req.DeliveryID)
+	if err != nil || (req.Outcome != "accepted" && req.Outcome != "rejected") {
+		return echo.NewHTTPError(http.StatusBadRequest)
+	}
+	changed := false
+	err = campaignDeliveryTx(a.db, id, func(ctx context.Context, tx *sqlx.Tx, _ string) error {
+		res, err := tx.ExecContext(ctx, `
+			UPDATE warpdrive_delivery_recipients
+			SET state = $3, lease_token = NULL, lease_until = NULL, updated_at = NOW()
+			WHERE campaign_id = $1 AND id = $2 AND (
+				state = 'unknown' OR (state = 'submitting' AND lease_until <= clock_timestamp())
+			)
+		`, id, deliveryID.String(), req.Outcome)
+		if err != nil {
+			return err
+		}
+		count, err := res.RowsAffected()
+		if err != nil {
+			return err
+		}
+		changed = count == 1
+		if changed && req.Outcome == "accepted" {
+			_, err := tx.ExecContext(ctx, "UPDATE campaigns SET sent = sent + 1, updated_at = NOW() WHERE id = $1", id)
+			return err
+		}
+		return nil
+	})
+	if err != nil {
+		a.log.Printf("could not resolve a delivery for campaign %d: %v", id, err)
+		return echo.NewHTTPError(http.StatusInternalServerError)
+	}
+	if !changed {
+		return echo.NewHTTPError(http.StatusConflict, "The delivery is no longer awaiting review.")
+	}
+	return c.JSON(http.StatusOK, okResp{true})
+}
+
+func (a *App) checkDeliveryResume(c echo.Context, id int) error {
+	ctx, cancel := context.WithTimeout(c.Request().Context(), deliveryDBTimeout)
+	defer cancel()
+	var blocked bool
+	if err := a.db.GetContext(ctx, &blocked, `
+		SELECT r.hold != '' OR EXISTS (
+			SELECT 1 FROM warpdrive_delivery_recipients WHERE campaign_id = $1
+			AND (state = 'unknown' OR (state = 'submitting' AND lease_until <= clock_timestamp()))
+		)
+		FROM warpdrive_delivery_runs r WHERE r.campaign_id = $1
+	`, id); err != nil && !errors.Is(err, sql.ErrNoRows) {
+		a.log.Printf("could not check delivery holds for campaign %d: %v", id, err)
+		return echo.NewHTTPError(http.StatusInternalServerError)
+	}
+	if blocked {
+		return echo.NewHTTPError(http.StatusConflict, "Review the campaign delivery hold before resuming.")
+	}
+	return nil
+}
diff --git a/cmd/warpdrive_delivery_store.go b/cmd/warpdrive_delivery_store.go
new file mode 100644
index 0000000..c56601d
--- /dev/null
+++ b/cmd/warpdrive_delivery_store.go
@@ -0,0 +1,359 @@
+package main
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"database/sql"
+	_ "embed"
+	"errors"
+	"time"
+
+	"github.com/jmoiron/sqlx"
+	"github.com/knadh/listmonk/models"
+	"github.com/lib/pq"
+)
+
+//go:embed warpdrive_delivery.sql
+var deliverySchema string
+
+const deliveryDBTimeout = 5 * time.Second
+
+func installDeliverySchema(db *sqlx.DB) error {
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	tx, err := db.BeginTxx(ctx, nil)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	if _, err := tx.ExecContext(ctx, "SELECT pg_advisory_xact_lock(900731613, 50)"); err != nil {
+		return err
+	}
+	if _, err := tx.ExecContext(ctx, `
+		CREATE TABLE IF NOT EXISTS warpdrive_delivery_migrations (
+			version INTEGER PRIMARY KEY, installed_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
+		)
+	`); err != nil {
+		return err
+	}
+	version, err := tx.ExecContext(ctx, "INSERT INTO warpdrive_delivery_migrations(version) VALUES (1) ON CONFLICT DO NOTHING")
+	if err != nil {
+		return err
+	}
+	first, err := version.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if first > 0 {
+		if _, err := tx.ExecContext(ctx, deliverySchema); err != nil {
+			return err
+		}
+		// A cursor from the old volatile queue cannot establish who actually received mail.
+		if _, err := tx.ExecContext(ctx, `
+			WITH held AS (
+				INSERT INTO warpdrive_delivery_runs(campaign_id, hold)
+				SELECT id, 'legacy' FROM campaigns
+				WHERE status IN ('running', 'scheduled', 'paused')
+				  AND (started_at IS NOT NULL OR sent > 0 OR last_subscriber_id > 0)
+				ON CONFLICT DO NOTHING RETURNING campaign_id
+			)
+			UPDATE campaigns SET status = 'paused', updated_at = NOW()
+			WHERE id IN (SELECT campaign_id FROM held) AND status != 'paused'
+		`); err != nil {
+			return err
+		}
+	}
+	return tx.Commit()
+}
+
+// Every state transition takes the campaign lock before touching its deliveries.
+func campaignDeliveryTx(db *sqlx.DB, id int, action func(context.Context, *sqlx.Tx, string) error) error {
+	ctx, cancel := context.WithTimeout(context.Background(), deliveryDBTimeout)
+	defer cancel()
+	tx, err := db.BeginTxx(ctx, nil)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	var status string
+	if err := tx.GetContext(ctx, &status, "SELECT status FROM campaigns WHERE id = $1 FOR UPDATE", id); err != nil {
+		return err
+	}
+	if err := action(ctx, tx, status); err != nil {
+		return err
+	}
+	return tx.Commit()
+}
+
+func pauseDeliveryRun(ctx context.Context, tx *sqlx.Tx, id int) error {
+	_, err := tx.ExecContext(ctx, "UPDATE campaigns SET status = 'paused', updated_at = NOW() WHERE id = $1 AND status = 'running'", id)
+	return err
+}
+
+func (s *store) PrepareDeliveryRun(id int, revision []byte) (bool, error) {
+	ready := false
+	err := campaignDeliveryTx(s.db, id, func(ctx context.Context, tx *sqlx.Tx, status string) error {
+		if status != models.CampaignStatusRunning {
+			return nil
+		}
+		if _, err := tx.ExecContext(ctx, `
+			INSERT INTO warpdrive_delivery_runs(campaign_id, revision, recipient_ceiling)
+			SELECT id, $2, max_subscriber_id FROM campaigns WHERE id = $1
+			ON CONFLICT DO NOTHING
+		`, id, revision); err != nil {
+			return err
+		}
+		var run struct {
+			Revision []byte
+			Hold     string
+		}
+		if err := tx.GetContext(ctx, &run, "SELECT revision, hold FROM warpdrive_delivery_runs WHERE campaign_id = $1", id); err != nil {
+			return err
+		}
+		if run.Hold == "" && !bytes.Equal(run.Revision, revision) {
+			run.Hold = "revision_changed"
+			if _, err := tx.ExecContext(ctx, "UPDATE warpdrive_delivery_runs SET hold = $2 WHERE campaign_id = $1", id, run.Hold); err != nil {
+				return err
+			}
+		}
+		if run.Hold != "" {
+			return pauseDeliveryRun(ctx, tx, id)
+		}
+		ready = true
+		return nil
+	})
+	return ready, err
+}
+
+func (s *store) NextSubscribers(id, limit int) ([]models.DeliveryLease, error) {
+	var leased []models.DeliveryLease
+	limit = min(limit, 200)
+	err := campaignDeliveryTx(s.db, id, func(ctx context.Context, tx *sqlx.Tx, status string) error {
+		if status != models.CampaignStatusRunning {
+			return nil
+		}
+		if _, err := tx.ExecContext(ctx, `
+			UPDATE warpdrive_delivery_recipients
+			SET state = CASE state WHEN 'submitting' THEN 'unknown' ELSE 'pending' END,
+			    lease_token = NULL, lease_until = NULL, updated_at = NOW()
+			WHERE campaign_id = $1 AND state IN ('leased', 'submitting') AND lease_until <= clock_timestamp()
+		`, id); err != nil {
+			return err
+		}
+		var run struct {
+			Hold             string
+			Exhausted        bool
+			Unknown          bool
+			Open             int
+			RecipientCeiling int `db:"recipient_ceiling"`
+		}
+		if err := tx.GetContext(ctx, &run, `
+			SELECT r.hold, r.exhausted, r.recipient_ceiling,
+			       EXISTS (SELECT 1 FROM warpdrive_delivery_recipients WHERE campaign_id = $1 AND state = 'unknown') AS unknown,
+			       (SELECT COUNT(*) FROM warpdrive_delivery_recipients WHERE campaign_id = $1 AND state IN ('pending', 'leased', 'submitting')) AS open
+			FROM warpdrive_delivery_runs r WHERE r.campaign_id = $1
+		`, id); err != nil {
+			return err
+		}
+		if run.Hold != "" || run.Unknown {
+			return pauseDeliveryRun(ctx, tx, id)
+		}
+		if !run.Exhausted && run.Open < limit {
+			if err := s.admitDeliveryBatch(ctx, tx, id, limit-run.Open, run.RecipientCeiling); err != nil {
+				return err
+			}
+		}
+
+		// The queue stores a digest, never a second copy of the subscriber's address.
+		if _, err := tx.ExecContext(ctx, `
+			UPDATE warpdrive_delivery_recipients d SET state = 'suppressed', updated_at = NOW()
+			WHERE d.campaign_id = $1 AND d.state = 'pending'
+			  AND NOT EXISTS (
+			    SELECT 1 FROM subscribers s WHERE s.id = d.subscriber_id AND s.uuid = d.subscriber_uuid
+			      AND sha256(convert_to(s.email, 'UTF8')) = d.address_digest
+			  )
+		`, id); err != nil {
+			return err
+		}
+		return tx.SelectContext(ctx, &leased, `
+			WITH candidates AS (
+				SELECT d.id FROM warpdrive_delivery_recipients d
+				JOIN subscribers s ON s.id = d.subscriber_id AND s.uuid = d.subscriber_uuid
+				  AND sha256(convert_to(s.email, 'UTF8')) = d.address_digest
+				WHERE d.campaign_id = $1 AND d.state = 'pending' AND d.available_at <= clock_timestamp()
+				ORDER BY d.subscriber_id LIMIT $2 FOR UPDATE OF d SKIP LOCKED
+			), claims AS (
+				UPDATE warpdrive_delivery_recipients d
+				SET state = 'leased', lease_token = gen_random_uuid(),
+				    lease_until = clock_timestamp() + INTERVAL '5 minutes', updated_at = NOW()
+				FROM candidates c WHERE d.id = c.id
+				RETURNING d.id, d.lease_token, d.subscriber_id
+			)
+			SELECT s.*, claims.id::TEXT AS delivery_id, claims.lease_token::TEXT AS lease_token
+			FROM claims JOIN subscribers s ON s.id = claims.subscriber_id ORDER BY s.id
+		`, id, limit)
+	})
+	return leased, err
+}
+
+func (s *store) admitDeliveryBatch(ctx context.Context, tx *sqlx.Tx, id, limit, ceiling int) error {
+	var campaigns []runningCamp
+	if err := tx.StmtxContext(ctx, s.queries.GetRunningCampaign).SelectContext(ctx, &campaigns, id); err != nil {
+		return err
+	}
+	var selected []models.Subscriber
+	if len(campaigns) > 0 {
+		listIDs := make([]int, 0, len(campaigns))
+		for _, campaign := range campaigns {
+			listIDs = append(listIDs, campaign.ListID)
+		}
+		campaign := campaigns[0]
+		// This statement advances the upstream cursor. It commits only with the receipts below.
+		if err := tx.StmtxContext(ctx, s.queries.NextCampaignSubscribers).SelectContext(ctx, &selected, id, campaign.CampaignType,
+			campaign.LastSubscriberID, ceiling, pq.Array(listIDs), limit); err != nil {
+			return err
+		}
+	}
+	if len(selected) == 0 {
+		_, err := tx.ExecContext(ctx, "UPDATE warpdrive_delivery_runs SET exhausted = TRUE WHERE campaign_id = $1", id)
+		return err
+	}
+	ids := make([]int, 0, len(selected))
+	uuids := make([]string, 0, len(selected))
+	digests := make(pq.ByteaArray, 0, len(selected))
+	for _, recipient := range selected {
+		ids = append(ids, recipient.ID)
+		uuids = append(uuids, recipient.UUID)
+		digest := sha256.Sum256([]byte(recipient.Email))
+		digests = append(digests, digest[:])
+	}
+	_, err := tx.ExecContext(ctx, `
+		INSERT INTO warpdrive_delivery_recipients(campaign_id, subscriber_id, subscriber_uuid, address_digest)
+		SELECT $1, id, uuid, address_digest FROM unnest($2::INTEGER[], $3::UUID[], $4::BYTEA[]) AS v(id, uuid, address_digest)
+		ON CONFLICT (campaign_id, subscriber_id) DO NOTHING
+	`, id, pq.Array(ids), pq.Array(uuids), digests)
+	return err
+}
+
+func (s *store) BeginDelivery(campaignID int, lease models.DeliveryLease, messageID string) (bool, error) {
+	started := false
+	err := campaignDeliveryTx(s.db, campaignID, func(ctx context.Context, tx *sqlx.Tx, status string) error {
+		if status != models.CampaignStatusRunning {
+			return releaseLease(ctx, tx, campaignID, lease, "pending")
+		}
+		// Serialize the global identity check with suppression and address changes. The
+		// existing campaign predicate also checks current list membership and CRM grant.
+		var id int
+		err := tx.GetContext(ctx, &id, "SELECT id FROM subscribers WHERE id = $1 FOR NO KEY UPDATE", lease.ID)
+		if errors.Is(err, sql.ErrNoRows) {
+			return releaseLease(ctx, tx, campaignID, lease, "suppressed")
+		}
+		if err != nil {
+			return err
+		}
+		// Lock the selected subscription and list rows before reading their consent.
+		var lists []int
+		if err := tx.SelectContext(ctx, &lists, `
+			SELECT sl.list_id FROM subscriber_lists sl
+			JOIN campaign_lists cl ON cl.list_id = sl.list_id AND cl.campaign_id = $1
+			JOIN lists l ON l.id = sl.list_id
+			WHERE sl.subscriber_id = $2 ORDER BY sl.list_id FOR SHARE OF l, sl
+		`, campaignID, lease.ID); err != nil {
+			return err
+		}
+		var eligible bool
+		if err := tx.StmtxContext(ctx, s.queries.CampaignRecipientEligible).GetContext(
+			ctx, &eligible, campaignID, lease.ID, lease.Email, lease.UUID,
+		); err != nil {
+			return err
+		}
+		if !eligible {
+			return releaseLease(ctx, tx, campaignID, lease, "suppressed")
+		}
+		digest := sha256.Sum256([]byte(lease.Email))
+		result, err := tx.ExecContext(ctx, `
+			UPDATE warpdrive_delivery_recipients
+			SET state = 'submitting', lease_until = clock_timestamp() + INTERVAL '90 seconds',
+			    message_id = $4, attempts = attempts + 1, updated_at = NOW()
+			WHERE campaign_id = $1 AND id = $2 AND lease_token = $3 AND state = 'leased'
+			  AND lease_until > clock_timestamp() AND subscriber_uuid = $5 AND address_digest = $6
+			  AND (message_id IS NULL OR message_id = $4)
+		`, campaignID, lease.DeliveryID, lease.LeaseToken, messageID, lease.UUID, digest[:])
+		if err != nil {
+			return err
+		}
+		count, err := result.RowsAffected()
+		started = count == 1
+		return err
+	})
+	return started, err
+}
+
+func (s *store) ReleaseDelivery(campaignID int, lease models.DeliveryLease, reject bool) error {
+	state := "pending"
+	if reject {
+		state = "rejected"
+	}
+	return campaignDeliveryTx(s.db, campaignID, func(ctx context.Context, tx *sqlx.Tx, _ string) error {
+		return releaseLease(ctx, tx, campaignID, lease, state)
+	})
+}
+
+func releaseLease(ctx context.Context, tx *sqlx.Tx, campaignID int, lease models.DeliveryLease, state string) error {
+	_, err := tx.ExecContext(ctx, `
+		UPDATE warpdrive_delivery_recipients
+		SET state = $4, lease_token = NULL, lease_until = NULL, updated_at = NOW()
+		WHERE campaign_id = $1 AND id = $2 AND lease_token = $3 AND state = 'leased'
+	`, campaignID, lease.DeliveryID, lease.LeaseToken, state)
+	return err
+}
+
+func (s *store) FinishDelivery(campaignID int, lease models.DeliveryLease, outcome models.DeliveryOutcome) (string, error) {
+	var state string
+	err := campaignDeliveryTx(s.db, campaignID, func(ctx context.Context, tx *sqlx.Tx, _ string) error {
+		if err := tx.GetContext(ctx, &state, `
+			UPDATE warpdrive_delivery_recipients
+			SET state = CASE WHEN $4 = 'retry' AND attempts < 3 THEN 'pending' WHEN $4 = 'retry' THEN 'rejected' ELSE $4 END,
+			    available_at = clock_timestamp() + (attempts * INTERVAL '30 seconds'),
+			    lease_token = NULL, lease_until = NULL, updated_at = NOW()
+			WHERE campaign_id = $1 AND id = $2 AND lease_token = $3 AND state = 'submitting'
+			RETURNING state
+		`, campaignID, lease.DeliveryID, lease.LeaseToken, outcome); err != nil {
+			return err
+		}
+		switch state {
+		case "accepted":
+			_, err := tx.ExecContext(ctx, "UPDATE campaigns SET sent = sent + 1, updated_at = NOW() WHERE id = $1", campaignID)
+			return err
+		case "unknown":
+			return pauseDeliveryRun(ctx, tx, campaignID)
+		}
+		return nil
+	})
+	return state, err
+}
+
+func (s *store) FinalizeDeliveryRun(campaignID int) (bool, error) {
+	finished := false
+	err := campaignDeliveryTx(s.db, campaignID, func(ctx context.Context, tx *sqlx.Tx, status string) error {
+		if status != models.CampaignStatusRunning {
+			return nil
+		}
+		result, err := tx.ExecContext(ctx, `
+			UPDATE campaigns SET status = 'finished', updated_at = NOW() WHERE id = $1
+			AND EXISTS (SELECT 1 FROM warpdrive_delivery_runs WHERE campaign_id = $1 AND exhausted AND hold = '')
+			AND NOT EXISTS (
+				SELECT 1 FROM warpdrive_delivery_recipients
+				WHERE campaign_id = $1 AND state IN ('pending', 'leased', 'submitting', 'unknown')
+			)
+		`, campaignID)
+		if err != nil {
+			return err
+		}
+		count, err := result.RowsAffected()
+		finished = count == 1
+		return err
+	})
+	return finished, err
+}
