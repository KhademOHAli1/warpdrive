+package s3
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/knadh/listmonk/internal/media"
+)
+
+func TestReadinessUsesSignedHead(t *testing.T) {
+	requests := make(chan *http.Request, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests <- r
+		w.WriteHeader(http.StatusOK)
+	}))
+	defer server.Close()
+	store, err := NewS3Store(Opt{URL: server.URL, Bucket: "fixture-bucket", BucketPath: "mail",
+		Region: "us-east-1", AccessKey: "fixture", SecretKey: "fixture"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	probe := store.(media.ReadinessProbe)
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if err := probe.ProbeReadiness(ctx, ""); !errors.Is(err, media.ErrReadinessUnchecked) {
+		t.Fatalf("empty bucket sample: %v", err)
+	}
+	if err := probe.ProbeReadiness(ctx, "sample.png"); err != nil {
+		t.Fatal(err)
+	}
+	got := <-requests
+	if got.Method != http.MethodHead || got.URL.Path != "/fixture-bucket/mail/sample.png" ||
+		got.URL.Query().Get("X-Amz-Signature") == "" {
+		t.Fatal("readiness did not use a scoped, authenticated HEAD")
+	}
+}
