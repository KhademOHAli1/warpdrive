+++ b/internal/manager/warpdrive_readiness_test.go
@@ -0,0 +1,34 @@
+package manager
+
+import (
+	"io"
+	"log"
+	"testing"
+	"time"
+)
+
+func TestEffectiveDeliveryLimitsAndScheduler(t *testing.T) {
+	original := Config{Concurrency: 100, MessageRate: 1000, BatchSize: 50000, DatabaseConnections: 6,
+		ScanCampaigns: true, ScanInterval: 5 * time.Second}
+	manager := New(original, nil, nil, log.New(io.Discard, "", 0))
+	want := DeliveryLimits{Workers: 3, PerWorkerMessagesPerSecond: 13, MessagesPerSecond: 39,
+		BatchSize: 200, QueueCapacity: 6, Clamped: true}
+	if manager.DeliveryLimits() != want || cap(manager.campMsgQ) != want.QueueCapacity {
+		t.Fatalf("runtime limits: %+v", manager.DeliveryLimits())
+	}
+	now := time.Now().UTC()
+	if got := manager.SchedulerReadiness(now); got.Status != "starting" || got.LastScanAt != nil {
+		t.Fatalf("initial scheduler: %+v", got)
+	}
+	manager.lastScan.Store(now.Add(-time.Second).UnixNano())
+	if got := manager.SchedulerReadiness(now); got.Status != "ready" || got.LastScanAt == nil {
+		t.Fatalf("live scheduler: %+v", got)
+	}
+	if got := manager.SchedulerReadiness(now.Add(time.Minute)); got.Status != "stale" || got.LastScanAt == nil {
+		t.Fatalf("stale scheduler: %+v", got)
+	}
+	manager.cfg.ScanCampaigns = false
+	if got := manager.SchedulerReadiness(now); got.Status != "passive" || got.LastScanAt != nil {
+		t.Fatalf("passive scheduler: %+v", got)
+	}
+}
