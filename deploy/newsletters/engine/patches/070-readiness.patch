diff --git a/cmd/warpdrive_readiness.go b/cmd/warpdrive_readiness.go
new file mode 100644
index 0000000..fbf6266
--- /dev/null
+++ b/cmd/warpdrive_readiness.go
@@ -0,0 +1,209 @@
+package main
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"net/http"
+	"sync"
+	"time"
+
+	"github.com/jmoiron/sqlx"
+	"github.com/knadh/listmonk/internal/manager"
+	"github.com/knadh/listmonk/internal/media"
+	"github.com/knadh/listmonk/internal/messenger/email"
+	"github.com/knadh/listmonk/internal/sesfeedback"
+	"github.com/labstack/echo/v4"
+	"github.com/lib/pq"
+)
+
+func installReadinessIndex(db *sqlx.DB) error {
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	tx, err := db.BeginTxx(ctx, nil)
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	if _, err := tx.ExecContext(ctx, "SELECT pg_advisory_xact_lock(900731613, 50)"); err != nil {
+		return err
+	}
+	res, err := tx.ExecContext(ctx, "INSERT INTO warpdrive_delivery_migrations(version) VALUES (4) ON CONFLICT DO NOTHING")
+	if err != nil {
+		return err
+	}
+	n, err := res.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if n == 1 {
+		if _, err := tx.ExecContext(ctx, `
+			CREATE INDEX warpdrive_delivery_smtp_recent ON warpdrive_delivery_recipients (campaign_id, smtp_accepted_at)
+			WHERE smtp_accepted_at IS NOT NULL
+		`); err != nil {
+			return err
+		}
+	}
+	return tx.Commit()
+}
+
+type readinessState struct {
+	Status string `json:"status"`
+}
+
+type checkedReadiness struct {
+	Status    string     `json:"status"`
+	CheckedAt *time.Time `json:"checkedAt"`
+}
+
+type feedbackReadiness struct {
+	Status      string     `json:"status"`
+	LastEventAt *time.Time `json:"lastEventAt"`
+}
+
+type readinessResult struct {
+	Ready     bool                       `json:"ready"`
+	Database  readinessState             `json:"database"`
+	Scheduler manager.SchedulerReadiness `json:"scheduler"`
+	Relay     checkedReadiness           `json:"relay"`
+	Media     checkedReadiness           `json:"media"`
+	Limits    manager.DeliveryLimits     `json:"limits"`
+	Feedback  feedbackReadiness          `json:"feedback"`
+}
+
+type cachedReadinessProbe struct {
+	mu     sync.Mutex
+	result checkedReadiness
+}
+
+func (p *cachedReadinessProbe) run(probe func(context.Context) string) checkedReadiness {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if p.result.CheckedAt != nil && time.Since(*p.result.CheckedAt) < 20*time.Second {
+		return p.result
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 4*time.Second)
+	defer cancel()
+	status := probe(ctx)
+	now := time.Now().UTC()
+	p.result = checkedReadiness{Status: status, CheckedAt: &now}
+	return p.result
+}
+
+type readinessProbes struct {
+	relay, media cachedReadinessProbe
+}
+
+func (a *App) GetWarpdriveReadiness(c echo.Context) error {
+	var result readinessResult
+	var checks sync.WaitGroup
+	checks.Go(func() { result.Relay = a.readiness.relay.run(a.checkRelayReadiness) })
+	checks.Go(func() { result.Media = a.readiness.media.run(a.checkMediaReadiness) })
+
+	ctx, cancel := context.WithTimeout(c.Request().Context(), 3*time.Second)
+	defer cancel()
+	result.Database.Status = a.checkDatabaseReadiness(ctx)
+	result.Feedback = a.checkFeedbackReadiness(ctx)
+	result.Limits = a.manager.DeliveryLimits()
+	checks.Wait()
+	result.Scheduler = a.manager.SchedulerReadiness(time.Now())
+	result.Ready = result.Database.Status == "ready" && result.Scheduler.Status == "ready" &&
+		result.Relay.Status == "ready" && result.Media.Status == "ready" &&
+		(result.Feedback.Status == "disabled" || result.Feedback.Status == "confirmed")
+	return c.JSON(http.StatusOK, okResp{result})
+}
+
+func (a *App) checkDatabaseReadiness(ctx context.Context) string {
+	var ready bool
+	err := a.db.GetContext(ctx, &ready, `
+		SELECT to_regclass('warpdrive_crm_identity_challenges') IS NOT NULL
+		   AND to_regclass('warpdrive_campaign_audiences') IS NOT NULL
+		   AND to_regclass('warpdrive_delivery_recipients') IS NOT NULL
+		   AND to_regclass('warpdrive_ses_feedback') IS NOT NULL
+		   AND to_regclass('warpdrive_delivery_smtp_recent') IS NOT NULL
+		   AND (SELECT count(*) FROM warpdrive_delivery_migrations WHERE version IN (1, 2, 3, 4)) = 4
+	`)
+	var dbError *pq.Error
+	switch {
+	case errors.As(err, &dbError) && (dbError.Code == "42P01" || dbError.Code == "42703"):
+		return "migration_required"
+	case err != nil:
+		return "unavailable"
+	case !ready:
+		return "migration_required"
+	default:
+		return "ready"
+	}
+}
+
+func (a *App) checkRelayReadiness(ctx context.Context) string {
+	relay, ok := a.emailMsgr.(*email.Emailer)
+	if !ok || relay == nil {
+		return "unconfigured"
+	}
+	err := relay.ProbeCampaignRelay(ctx)
+	switch {
+	case errors.Is(err, email.ErrRelayUnconfigured):
+		return "unconfigured"
+	case err != nil:
+		return "unavailable"
+	default:
+		return "ready"
+	}
+}
+
+func (a *App) checkMediaReadiness(ctx context.Context) string {
+	probe, ok := a.media.(media.ReadinessProbe)
+	if !ok {
+		return "unchecked"
+	}
+	var sample string
+	if ko.String("upload.provider") == "s3" {
+		err := a.db.GetContext(ctx, &sample, "SELECT filename FROM media WHERE provider='s3' ORDER BY id DESC LIMIT 1")
+		if err != nil && !errors.Is(err, sql.ErrNoRows) {
+			return "unavailable"
+		}
+	}
+	err := probe.ProbeReadiness(ctx, sample)
+	switch {
+	case errors.Is(err, media.ErrReadinessUnchecked):
+		return "unchecked"
+	case err != nil:
+		return "unavailable"
+	default:
+		return "ready"
+	}
+}
+
+func (a *App) checkFeedbackReadiness(ctx context.Context) feedbackReadiness {
+	config, err := sesfeedback.ConfigFromEnv()
+	if err != nil {
+		return feedbackReadiness{Status: "configured"}
+	}
+	if !config.Enabled() {
+		return feedbackReadiness{Status: "disabled"}
+	}
+	result := feedbackReadiness{Status: "configured"}
+	var status struct {
+		Confirmed   bool
+		LastEventAt sql.NullTime `db:"last_event_at"`
+	}
+	if err := a.db.GetContext(ctx, &status, `
+		SELECT COALESCE((
+			SELECT kind='subscription' FROM warpdrive_ses_feedback WHERE topic_arn=$1
+			AND kind IN ('subscription','unsubscribe') ORDER BY received_at DESC LIMIT 1
+		), FALSE) AS confirmed, (
+			SELECT MAX(received_at) FROM warpdrive_ses_feedback WHERE topic_arn=$1
+			AND kind IN ('hard','soft','complaint')
+		) AS last_event_at
+	`, config.TopicARN); err == nil {
+		if status.Confirmed {
+			result.Status = "confirmed"
+		}
+		if status.LastEventAt.Valid {
+			at := status.LastEventAt.Time.UTC()
+			result.LastEventAt = &at
+		}
+	}
+	return result
+}
