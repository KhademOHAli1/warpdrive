@@ -0,0 +1,33 @@
+package filesystem
+
+import (
+	"context"
+	"errors"
+	"os"
+)
+
+func (c *Client) ProbeReadiness(ctx context.Context, _ string) (err error) {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	file, err := os.CreateTemp(getDir(c.opts.UploadPath), ".warpdrive-probe-")
+	if err != nil {
+		return err
+	}
+	defer func() { err = errors.Join(err, os.Remove(file.Name())) }()
+	if _, err := file.WriteString("warpdrive"); err != nil {
+		file.Close()
+		return err
+	}
+	if err := file.Close(); err != nil {
+		return err
+	}
+	data, err := os.ReadFile(file.Name())
+	if err != nil {
+		return err
+	}
+	if string(data) != "warpdrive" {
+		return errors.New("media storage probe did not round-trip")
+	}
+	return nil
+}
