+package email
+
+import (
+	"context"
+	"errors"
+
+	"github.com/knadh/listmonk/internal/sesfeedback"
+	"github.com/knadh/smtppool/v2"
+)
+
+var ErrRelayUnconfigured = errors.New("no campaign relay is configured")
+
+// ProbeCampaignRelay checks TLS, SMTP negotiation and configured authentication.
+// The SMTP transaction is never started.
+func (e *Emailer) ProbeCampaignRelay(ctx context.Context) error {
+	relays := e.pools[""]
+	if len(relays) == 0 {
+		return ErrRelayUnconfigured
+	}
+	config, err := sesfeedback.ConfigFromEnv()
+	if err != nil {
+		return err
+	}
+	for _, relay := range relays {
+		if config.Enabled() && (relay.Host != config.SMTPHost() || relay.SSL == smtppool.SSLNone ||
+			relay.TLSSkipVerify || relay.Auth == nil) {
+			return ErrRelayUnconfigured
+		}
+		client, err := openCampaignSMTP(ctx, relay)
+		if err != nil {
+			return err
+		}
+		err = client.Noop()
+		client.Close()
+		if err != nil {
+			return err
+		}
+	}
+	return nil
+}
