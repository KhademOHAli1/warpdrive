+
+func (c *Client) ProbeReadiness(ctx context.Context, filename string) error {
+	if filename == "" {
+		return media.ErrReadinessUnchecked
+	}
+	if filepath.Base(filename) != filename {
+		return errors.New("invalid media sample")
+	}
+	signed := c.s3.GeneratePresignedURL(simples3.PresignedInput{
+		Bucket: c.opts.Bucket, ObjectKey: c.makeBucketPath(filename),
+		Method: http.MethodHead, ExpirySeconds: 15,
+	})
+	request, err := http.NewRequestWithContext(ctx, http.MethodHead, signed, nil)
+	if err != nil {
+		return err
+	}
+	response, err := probeClient.Do(request)
+	if err != nil {
+		return err
+	}
+	defer response.Body.Close()
+	if response.StatusCode < 200 || response.StatusCode >= 300 {
+		return errors.New("media object HEAD failed")
+	}
+	return nil
+}
