diff --git a/internal/manager/warpdrive_readiness.go b/internal/manager/warpdrive_readiness.go
new file mode 100644
index 0000000..20dd5de
--- /dev/null
+++ b/internal/manager/warpdrive_readiness.go
@@ -0,0 +1,63 @@
+package manager
+
+import "time"
+
+const (
+	maxDeliveryWorkers = 8
+	maxDeliveryRate    = 40
+	maxDeliveryBatch   = 200
+)
+
+type DeliveryLimits struct {
+	Workers                    int  `json:"workers"`
+	PerWorkerMessagesPerSecond int  `json:"perWorkerMessagesPerSecond"`
+	MessagesPerSecond          int  `json:"messagesPerSecond"`
+	BatchSize                  int  `json:"batchSize"`
+	QueueCapacity              int  `json:"queueCapacity"`
+	Clamped                    bool `json:"clamped"`
+}
+
+func normalizeDeliveryLimits(config Config) (Config, DeliveryLimits) {
+	workers := max(config.Concurrency, 1)
+	rate := max(config.MessageRate, 1)
+	batch := config.BatchSize
+	if batch < 1 {
+		batch = 1000
+	}
+	workerBudget := maxDeliveryWorkers
+	if config.DatabaseConnections > 0 {
+		workerBudget = min(workerBudget, max(1, config.DatabaseConnections/2))
+	}
+	config.Concurrency = min(workers, workerBudget)
+	config.MessageRate = min(rate, maxDeliveryRate/config.Concurrency)
+	config.BatchSize = min(batch, maxDeliveryBatch)
+	return config, DeliveryLimits{
+		Workers: config.Concurrency, PerWorkerMessagesPerSecond: config.MessageRate,
+		MessagesPerSecond: config.Concurrency * config.MessageRate, BatchSize: config.BatchSize,
+		QueueCapacity: config.Concurrency * 2,
+		Clamped:       workers != config.Concurrency || rate != config.MessageRate || batch != config.BatchSize,
+	}
+}
+
+func (m *Manager) DeliveryLimits() DeliveryLimits { return m.limits }
+
+type SchedulerReadiness struct {
+	Status     string     `json:"status"`
+	LastScanAt *time.Time `json:"lastScanAt"`
+}
+
+func (m *Manager) SchedulerReadiness(now time.Time) SchedulerReadiness {
+	if !m.cfg.ScanCampaigns {
+		return SchedulerReadiness{Status: "passive"}
+	}
+	lastScan := m.lastScan.Load()
+	if lastScan == 0 {
+		return SchedulerReadiness{Status: "starting"}
+	}
+	at := time.Unix(0, lastScan).UTC()
+	status := "ready"
+	if now.Sub(at) > 3*m.cfg.ScanInterval {
+		status = "stale"
+	}
+	return SchedulerReadiness{Status: status, LastScanAt: &at}
+}
diff --git a/internal/manager/warpdrive_readiness_test.go b/internal/manager/warpdrive_readiness_test.go
new file mode 100644
