+	"strings"
+	"testing"
+
+	"github.com/jmoiron/sqlx"
+)
+
+func TestSignedOperationalOutboxWithPostgres(t *testing.T) {
+	dsn := os.Getenv("WARPDRIVE_SES_FIXTURE_DSN")
+	if dsn == "" {
+		t.Skip("disposable PostgreSQL fixture not requested")
+	}
+	if !strings.HasPrefix(dsn, "host=/tmp/lm-ses-") || !strings.Contains(dsn, "dbname=consent user=consentproof sslmode=disable") {
+		t.Fatal("use the disposable fixture runner")
+	}
+	db, err := sqlx.Connect("postgres", dsn)
+	must(t, err)
+	defer db.Close()
+	f := newSignedFixture(t)
+	h := &handler{db: db, config: f.verification.config, verify: f.verification, log: log.New(io.Discard, "", 0)}
+	job := seedJob(t, db, "operational-hard@example.test", "unknown")
+	hard := f.event(job, job.email, "Permanent", "operational-hard", 0)
+	if status := requestStatus(h, hard); status != http.StatusNoContent {
+		t.Fatalf("signed hard feedback returned %d", status)
+	}
+	checkValue(t, db, 1, `SELECT count(*) FROM warpdrive_operational_events
+		WHERE event_key=digest('feedback:' || $1 || ':hard:matched','sha256') AND reason='hard_bounce'`, job.delivery)
+	checkValue(t, db, 1, `SELECT count(*) FROM warpdrive_operational_events
+		WHERE event_key=digest('delivery:' || $1 || ':delivery.resolved','sha256') AND reason='provider_accepted'`, job.delivery)
+	repeat := hard
+	repeat.MessageID = randomID()
+	repeat = f.sign(repeat)
+	if status := requestStatus(h, repeat); status != http.StatusNoContent {
+		t.Fatalf("semantic duplicate returned %d", status)
+	}
+	checkValue(t, db, 1, `SELECT count(*) FROM warpdrive_operational_events
+		WHERE event_key=digest('feedback:' || $1 || ':hard:matched','sha256')`, job.delivery)
+
+	unmatched := seedJob(t, db, "operational-unmatched@example.test", "unknown")
+	complaint := f.event(unmatched, "different-operational@example.test", "Complaint", "operational-unmatched", 0)
+	if status := requestStatus(h, complaint); status != http.StatusNoContent {
+		t.Fatalf("signed unmatched complaint returned %d", status)
+	}
+	checkValue(t, db, 1, `SELECT count(*) FROM warpdrive_operational_events
+		WHERE event_key=digest('feedback:' || $1 || ':complaint:unmatched','sha256') AND reason='unmatched_complaint'`, unmatched.delivery)
+	checkValue(t, db, "unknown", "SELECT state FROM warpdrive_delivery_recipients WHERE id=$1", unmatched.delivery)
+	checkValue(t, db, "enabled", "SELECT status FROM subscribers WHERE id=$1", unmatched.subscriber)
+	forged := f.event(unmatched, unmatched.email, "Complaint", "operational-forged", 0)
+	forged.Message += " "
+	if status := requestStatus(h, forged); status != http.StatusForbidden {
+		t.Fatalf("forged signature returned %d", status)
+	}
+	checkValue(t, db, 0, "SELECT count(*) FROM warpdrive_ses_feedback WHERE sns_id=$1", forged.MessageID)
+	matched := f.event(unmatched, unmatched.email, "Complaint", "operational-matched", 0)
+	if status := requestStatus(h, matched); status != http.StatusNoContent {
+		t.Fatalf("later exact matched complaint returned %d", status)
+	}
+	checkValue(t, db, 1, `SELECT count(*) FROM warpdrive_operational_events
+		WHERE event_key=digest('feedback:' || $1 || ':complaint:matched','sha256') AND reason='complaint'`, unmatched.delivery)
+	checkValue(t, db, 1, `SELECT count(*) FROM warpdrive_operational_events
+		WHERE event_key=digest('feedback:' || $1 || ':complaint:unmatched','sha256') AND reason='unmatched_complaint'`, unmatched.delivery)
+	checkValue(t, db, "blocklisted", "SELECT status FROM subscribers WHERE id=$1", unmatched.subscriber)
+	matched.MessageID = randomID()
+	matched = f.sign(matched)
+	if status := requestStatus(h, matched); status != http.StatusNoContent {
+		t.Fatalf("matched complaint duplicate returned %d", status)
+	}
+	checkValue(t, db, 1, `SELECT count(*) FROM warpdrive_operational_events
+		WHERE event_key=digest('feedback:' || $1 || ':complaint:matched','sha256')`, unmatched.delivery)
+
+	rollback := seedJob(t, db, "operational-rollback@example.test", "unknown")
+	_, err = db.Exec(fmt.Sprintf(`
+		CREATE FUNCTION reject_operational_fixture() RETURNS trigger LANGUAGE plpgsql AS $$
+		BEGIN RAISE EXCEPTION 'synthetic outbox unavailable'; END; $$;
+		CREATE TRIGGER reject_operational_fixture BEFORE INSERT ON warpdrive_operational_events FOR EACH ROW
+		WHEN (NEW.event_key=digest('feedback:%s:hard:matched','sha256')) EXECUTE FUNCTION reject_operational_fixture();
+	`, rollback.delivery))
+	must(t, err)
+	defer db.Exec("DROP TRIGGER IF EXISTS reject_operational_fixture ON warpdrive_operational_events; DROP FUNCTION IF EXISTS reject_operational_fixture()")
+	retriable := f.event(rollback, rollback.email, "Permanent", "operational-rollback", 0)
+	if status := requestStatus(h, retriable); status != http.StatusServiceUnavailable {
+		t.Fatalf("outbox failure returned %d", status)
+	}
+	checkValue(t, db, 0, "SELECT count(*) FROM warpdrive_ses_feedback WHERE sns_id=$1", retriable.MessageID)
+	checkValue(t, db, 0, "SELECT count(*) FROM bounces WHERE campaign_id=$1", rollback.campaign)
+	checkValue(t, db, "unknown", "SELECT state FROM warpdrive_delivery_recipients WHERE id=$1", rollback.delivery)
+	checkValue(t, db, "enabled", "SELECT status FROM subscribers WHERE id=$1", rollback.subscriber)
+	_, err = db.Exec("DROP TRIGGER reject_operational_fixture ON warpdrive_operational_events")
+	must(t, err)
+	if status := requestStatus(h, retriable); status != http.StatusNoContent {
+		t.Fatalf("outbox recovery returned %d", status)
+	}
+	checkValue(t, db, 1, `SELECT count(*) FROM warpdrive_operational_events
+		WHERE event_key=digest('feedback:' || $1 || ':hard:matched','sha256')`, rollback.delivery)
+	checkValue(t, db, false, `SELECT EXISTS (SELECT 1 FROM warpdrive_operational_events
+		WHERE row_to_json(warpdrive_operational_events)::text LIKE '%@example.test%')`)
+}
