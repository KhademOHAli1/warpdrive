--- name: update-subscriber
-UPDATE subscribers SET
-    email=(CASE WHEN $2 != '' THEN $2 ELSE email END),
-    name=(CASE WHEN $3 != '' THEN $3 ELSE name END),
-    status=(CASE WHEN $4 != '' THEN $4::subscriber_status ELSE status END),
-    attribs=(CASE WHEN $5 != '' THEN $5::JSONB ELSE attribs END),
-    updated_at=NOW()
-WHERE id = $1;
+-- name: update-public-subscriber-name
+UPDATE subscribers SET name=$2, updated_at=NOW() WHERE uuid=$1::UUID RETURNING id;
+
+-- name: subscribe-public
+WITH publicLists AS MATERIALIZED (
+    SELECT id FROM lists WHERE uuid=ANY($4::UUID[]) AND type='public' AND status='active'
+    FOR SHARE
+),
+sub AS (
+    INSERT INTO subscribers AS existing (uuid, email, name, status)
+    SELECT $1, $2, $3, 'enabled' WHERE EXISTS (SELECT 1 FROM publicLists)
+    -- The conflict branch locks the current subscriber and rechecks suppression.
+    -- An existing profile is left intact, including its address and status.
+    ON CONFLICT (LOWER(email)) DO UPDATE SET name=existing.name WHERE existing.status='enabled'
+    RETURNING id
+),
+added AS (
+    INSERT INTO subscriber_lists (subscriber_id, list_id, status)
+    SELECT sub.id, publicLists.id, 'unconfirmed' FROM sub CROSS JOIN publicLists
+    ON CONFLICT (subscriber_id, list_id) DO NOTHING
+    RETURNING list_id
+),
+pending AS (
+    SELECT list_id FROM added
+    UNION
+    SELECT sl.list_id FROM subscriber_lists sl
+    JOIN sub ON sl.subscriber_id=sub.id
+    JOIN publicLists ON sl.list_id=publicLists.id
+    WHERE sl.status='unconfirmed'
+)
+SELECT sub.id, ARRAY(SELECT list_id FROM pending) AS list_ids FROM sub;
 
