diff --git a/internal/messenger/email/warpdrive_recipient_headers_test.go b/internal/messenger/email/warpdrive_recipient_headers_test.go
new file mode 100644
--- /dev/null
+++ b/internal/messenger/email/warpdrive_recipient_headers_test.go
@@ -0,0 +1,21 @@
+package email
+
+import (
+	"net/textproto"
+	"testing"
+)
+
+func TestCampaignHeadersCannotExpandOrReplaceEnvelope(t *testing.T) {
+	headers := textproto.MIMEHeader{
+		"Cc":               {"extra@example.test"},
+		"BCC":              {"hidden@example.test"},
+		"To":               {"different@example.test"},
+		"Resent-To":        {"resend@example.test"},
+		"Reply-To":         {"reply@example.test"},
+		"List-Unsubscribe": {"<https://newsletter.example.test/subscription/example>"},
+	}
+	stripCampaignRecipientHeaders(headers)
+	if len(headers) != 2 || headers.Get("Reply-To") == "" || headers.Get("List-Unsubscribe") == "" {
+		t.Fatalf("unexpected retained header keys: %v", headers)
+	}
+}
