diff --git a/internal/manager/warpdrive_dispatch_test.go b/internal/manager/warpdrive_dispatch_test.go
new file mode 100644
--- /dev/null
+++ b/internal/manager/warpdrive_dispatch_test.go
@@ -0,0 +1,109 @@
+package manager
+
+import (
+	"errors"
+	"io"
+	"log"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/knadh/listmonk/models"
+	"github.com/paulbellamy/ratecounter"
+)
+
+type consentStore struct {
+	Store
+	eligible bool
+	err      error
+	checked  int
+}
+
+func (s *consentStore) CampaignRecipientEligible(id int, sub models.Subscriber) (bool, error) {
+	if id != 5 || sub.ID != 7 || sub.Email != "reader+fixture@example.test" {
+		return false, errors.New("wrong queued recipient")
+	}
+	s.checked++
+	return s.eligible, s.err
+}
+
+func (s *consentStore) CampaignTestRecipientEligible(sub models.Subscriber) (bool, error) {
+	return s.CampaignRecipientEligible(5, sub)
+}
+
+type captureMessenger struct {
+	Messenger
+	sent []models.Message
+}
+
+func (m *captureMessenger) Push(message models.Message) error {
+	m.sent = append(m.sent, message)
+	return nil
+}
+
+func TestCampaignWorkerRechecksConsentBeforeTransport(t *testing.T) {
+	for _, scenario := range []struct {
+		name           string
+		eligible       bool
+		lookupError    error
+		testMessage    bool
+		approved       string
+		expectedChecks int
+		expectedSends  int
+	}{
+		{name: "eligible", eligible: true, expectedChecks: 1, expectedSends: 1},
+		{name: "revoked after queue", expectedChecks: 1},
+		{name: "lookup error fails closed", lookupError: errors.New("unavailable"), expectedChecks: 1},
+		{name: "test address denied by default", testMessage: true},
+		{name: "test domain wildcard denied", testMessage: true, approved: "*@example.test"},
+		{name: "exact approved plus alias", eligible: true, testMessage: true, approved: " reader+Fixture@example.test ", expectedChecks: 1, expectedSends: 1},
+		{name: "approved test address loses eligibility", testMessage: true, approved: "reader+fixture@example.test", expectedChecks: 1},
+	} {
+		t.Run(scenario.name, func(t *testing.T) {
+			t.Setenv("NEWSLETTER_TEST_RECIPIENTS", scenario.approved)
+			s := &consentStore{eligible: scenario.eligible, err: scenario.lookupError}
+			capture := &captureMessenger{}
+			manager := &Manager{
+				cfg:        Config{MessageRate: 10},
+				store:      s,
+				messengers: map[string]Messenger{"email": capture},
+				log:        log.New(io.Discard, "", 0),
+				campMsgQ:   make(chan CampaignMessage, 1),
+				msgQ:       make(chan models.Message),
+			}
+			sub := models.Subscriber{Base: models.Base{ID: 7}, Email: "reader+fixture@example.test"}
+			campaign := &models.Campaign{Base: models.Base{ID: 5}, Messenger: "email"}
+			message := CampaignMessage{Campaign: campaign, Subscriber: sub, to: sub.Email}
+			if !scenario.testMessage {
+				message.pipe = &pipe{
+					camp: campaign,
+					m:    manager,
+					wg:   &sync.WaitGroup{},
+					rate: ratecounter.NewRateCounter(time.Minute),
+				}
+				message.pipe.wg.Add(1)
+			}
+			manager.campMsgQ <- message
+			close(manager.campMsgQ)
+			manager.worker()
+
+			if s.checked != scenario.expectedChecks || len(capture.sent) != scenario.expectedSends {
+				t.Fatalf("checks=%d, transport=%d", s.checked, len(capture.sent))
+			}
+			if message.pipe != nil {
+				if message.pipe.sent.Load() != int64(scenario.expectedSends) {
+					t.Fatal("skipped recipient counted as sent")
+				}
+				if (scenario.lookupError != nil) != message.pipe.withErrors.Load() {
+					t.Fatal("lookup failure did not pause the pipe")
+				}
+			}
+			if len(capture.sent) == 1 {
+				to := capture.sent[0].To
+				if len(to) != 1 || to[0] != sub.Email {
+					t.Fatalf("unexpected admitted envelope %v", to)
+				}
+			}
+		})
+	}
+}
