+// TestRecipientApproved is an exact installation allowlist, empty by default.
+func TestRecipientApproved(address string) bool {
+	for _, allowed := range strings.Split(os.Getenv("NEWSLETTER_TEST_RECIPIENTS"), ",") {
+		allowed = strings.TrimSpace(allowed)
+		if allowed != "" && strings.EqualFold(allowed, address) {
+			return true
+		}
+	}
+	return false
+}
+
+func (m *Manager) dispatchEligible(msg CampaignMessage) (bool, error) {
+	if msg.pipe == nil {
+		if !TestRecipientApproved(msg.to) {
+			return false, nil
+		}
+		return m.store.CampaignTestRecipientEligible(msg.Subscriber)
+	}
+	if msg.pipe.stopped.Load() {
+		return false, nil
+	}
+	return m.store.CampaignRecipientEligible(msg.Campaign.ID, msg.Subscriber)
+}
