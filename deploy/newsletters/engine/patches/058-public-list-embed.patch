+// embeddedSignupList recognizes a single list scope on the existing public form route.
+func (a *App) embeddedSignupList(c echo.Context) (*models.List, error) {
+	values, scoped := c.QueryParams()["l"]
+	if !scoped {
+		return nil, nil
+	}
+	if len(values) != 1 || !reUUID.MatchString(values[0]) {
+		return nil, echo.NewHTTPError(http.StatusNotFound)
+	}
+	list, err := a.core.GetList(0, values[0])
+	if err != nil || list.Type != models.ListTypePublic || list.Status != models.ListStatusActive {
+		return nil, echo.NewHTTPError(http.StatusNotFound)
+	}
+	return &list, nil
+}
