from pathlib import Path
import argparse
import json
import subprocess
import time

parser = argparse.ArgumentParser()
parser.add_argument("profile", choices=("reason", "authority-candidate"))
args = parser.parse_args()
root = Path(__file__).resolve().parent.parent
controls = json.loads((root / ".runtime/agency-core-source-readonly-controls.json").read_text())
for index, command in enumerate(controls["profiles"][args.profile]["commands"], 1):
    started = time.monotonic()
    print(json.dumps({"profile": args.profile, "phase": index, "command": command}), flush=True)
    result = subprocess.run(command, cwd=root)
    print(json.dumps({"profile": args.profile, "phase": index,
                      "exitCode": result.returncode,
                      "seconds": round(time.monotonic() - started, 4)}), flush=True)
    if result.returncode:
        raise SystemExit(result.returncode)
