{
  "name": "warpdrive",
  "version": "1.4.0",
  "description": "An open-source, self-hosted CRM for a company business-development team.",
  "main": "index.js",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --bun next dev --webpack",
    "build": "bun --bun next build --webpack",
    "build:workers": "bun scripts/build-workers.mjs",
    "build:docker": "bun --bun next build --webpack && bun scripts/build-workers.mjs",
    "start": "bun --bun next start",
    "test": "bun --bun vitest run",
    "test:unit": "bun --bun vitest run --project unit",
    "test:integration": "bun --bun vitest run --project integration",
    "test:watch": "bun --bun vitest",
    "lint": "bun run i18n:check && bun --bun biome check . && bun --bun eslint . --no-warn-ignored",
    "lint:fix": "bun --bun biome check --write . && bun --bun eslint . --fix --no-warn-ignored",
    "typecheck": "bun --bun next typegen && bun --bun tsc --noEmit -p tsconfig.typecheck.json",
    "format": "bun --bun biome format --write .",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:seed:smoke": "bun --env-file .env scripts/seed-smoke.ts",
    "db:seed:smoke:phase5": "bun --env-file .env scripts/seed-smoke-phase5.ts",
    "db:seed:demo": "bun --env-file .env scripts/seed-demo.ts",
    "email:sweep-spam": "bun --env-file .env src/entrypoints/sweepSpam.ts",
    "ui:check": "bun scripts/shadcn.ts check",
    "ui:update": "bun scripts/shadcn.ts update",
    "ui:audit": "bun scripts/shadcn.ts audit",
    "ui:record": "bun scripts/shadcn.ts record",
    "ui:verify": "bun run typecheck && bun run test:unit src/components/ui src/features/i18n src/features/identity src/features/navigation src/components/shell src/features/activities/ActivityDatePicker.test.tsx",
    "i18n:audit": "bun scripts/i18n/audit.ts",
    "i18n:check": "bun scripts/i18n/audit.ts --check"
  },
  "keywords": [],
  "author": "Nikita Sawinyh",
  "license": "MIT",
  "dependencies": {
    "@daypicker/persian": "^10.0.2",
    "@daypicker/react": "^10.0.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@js-temporal/polyfill": "0.5.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.105.0",
    "@tiptap/extension-color": "^3.32.1",
    "@tiptap/extension-font-family": "^3.32.1",
    "@tiptap/extension-image": "^3.32.1",
    "@tiptap/extension-link": "^3.32.1",
    "@tiptap/extension-text-style": "^3.32.1",
    "@tiptap/extension-underline": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "@trpc/client": "^11.22.1",
    "@trpc/react-query": "^11.22.1",
    "@trpc/server": "^11.22.1",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "isomorphic-dompurify": "^4.6.0",
    "jose": "^6.2.14",
    "lucide-react": "^1.64.0",
    "marked": "^18.1.2",
    "mcp-handler": "2.3.0",
    "minio": "^8.0.7",
    "next": "^16.4.3",
    "next-intl": "4.14.9",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "posthog-js": "^1.442.1",
    "posthog-node": "^5.60.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.18.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "use-intl": "4.14.9",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@modelcontextprotocol/client": "2.4.0",
    "@next/eslint-plugin-next": "^16.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testcontainers/postgresql": "^12.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "happy-dom": "^21.0.4",
    "jsdom": "29.1.1",
    "postcss": "^8.5.32",
    "shadcn": "4.23.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "patchedDependencies": {
    "next@16.4.3": "patches/next@16.4.3.patch"
  }
}
