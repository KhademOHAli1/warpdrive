+let h: TestDb;
+beforeEach(async () => {
+  h = await makeTestDb();
+});
+afterEach(async () => {
+  await h.close();
+});
+
+test("a real flags writer commits before the queued native edit rechecks authority", async () => {
+  const f = await currentAuthorityFixture(h);
+  const before = await readDealEffects(h, f);
+  const writer = heldTransaction(h, (tx) => replaceEditFlag(tx, f, false));
+  let command:
+    | ReturnType<typeof observedTransaction<Awaited<ReturnType<typeof editDeal>>>>
+    | undefined;
+  try {
+    expect(await writer.ready).toEqual({ ok: true, value: true });
+    command = observedTransaction(h, (tx) => editDeal({ db: tx }, f, "Denied queued edit"));
+    await waitForBackendLock(h, await command.backend, "advisory");
+    expect(command.isSettled()).toBe(false);
+  } finally {
+    writer.release();
+    await Promise.all([writer.drained, command?.drained]);
+  }
+  assert(command !== undefined);
+  expect(await writer.task).toEqual({ ok: true, value: true });
+  expect(await command.task).toMatchObject({ ok: false, error: { id: ERROR_IDS.PERM_DENIED } });
+  expect(await readDealEffects(h, f)).toEqual(before);
+  expect(
+    await h.db.select().from(auditEvents).where(eq(auditEvents.targetId, f.permissionSet.id)),
+  ).toEqual([expect.objectContaining({ action: "permission_set.update" })]);
+});
+
+test("an admitted native edit holds the real flags writer until its local commit", async () => {
+  const f = await currentAuthorityFixture(h);
+  const before = await readDealEffects(h, f);
+  const rowBlocker = heldTransaction(h, async (tx) => {
+    await tx
+      .select({ id: deals.id })
+      .from(deals)
+      .where(eq(deals.id, f.f.deals.visible.id))
+      .for("update");
+  });
+  let command:
+    | ReturnType<typeof observedTransaction<Awaited<ReturnType<typeof editDeal>>>>
+    | undefined;
+  let writer:
+    | ReturnType<typeof observedTransaction<Awaited<ReturnType<typeof replaceEditFlag>>>>
+    | undefined;
+  try {
+    await rowBlocker.ready;
+    command = observedTransaction(h, (tx) => editDeal({ db: tx }, f, "Admitted before removal"));
+    await waitForBackendLock(h, await command.backend, "row");
+    writer = observedTransaction(h, (tx) => replaceEditFlag(tx, f, false));
+    await waitForBackendLock(h, await writer.backend, "advisory");
+    expect(command.isSettled()).toBe(false);
+    expect(writer.isSettled()).toBe(false);
+  } finally {
+    rowBlocker.release();
+    await Promise.all([rowBlocker.drained, command?.drained, writer?.drained]);
+  }
+  assert(command !== undefined && writer !== undefined);
+  expect(await rowBlocker.task).toBeUndefined();
+  expect((await command.task).ok).toBe(true);
+  expect(await writer.task).toEqual({ ok: true, value: true });
+  const after = await readDealEffects(h, f);
+  expect(after.deal?.title).toBe("Admitted before removal");
+  expect(after.logs).toHaveLength(before.logs.length + 1);
+  expect(Number(after.versions[0]?.version)).toBe(Number(before.versions[0]?.version ?? 0) + 1);
+  const [set] = await h.db
+    .select()
+    .from(permissionSets)
+    .where(eq(permissionSets.id, f.permissionSet.id));
+  expect(set?.flags["deal.edit_own"]).toBe(false);
+  expect(
+    await h.db.select().from(auditEvents).where(eq(auditEvents.targetId, f.permissionSet.id)),
+  ).toEqual([expect.objectContaining({ action: "permission_set.update" })]);
