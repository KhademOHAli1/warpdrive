+++ b/src/features/auth/currentNativeSession.ts
@@ -0,0 +1,113 @@
+import { and, eq, sql, TransactionRollbackError } from "drizzle-orm";
+import { AppError, ERROR_IDS } from "@/constants/errorIds";
+import type { Db } from "@/db/client";
+import { authUsers, sessions, users } from "@/db/schema";
+import { type HydratedActor, hydrateActor } from "@/server/hydrateActor";
+import { err, type Result } from "@/types/result";
+import { evaluateSessionAccess } from "./better/accessPolicy";
+import { type AuthorityTransaction, lockCurrentAuthorityRead } from "./currentAuthorityFence";
+import { readAuthPolicy } from "./management/policy";
+
+// Internal handle from a server credential check, never authentication by itself. An HTTP
+// caller must obtain it from authenticated context, not from command fields or a cookie ID.
+export interface NativeSessionRef {
+  readonly userId: string;
+  readonly sessionId: string;
+}
+
+type NativeSessionDenied = { ok: false; error: "native_session_invalid" };
+
+// No touching, no fresh-authentication escalation, and no implicit transaction/lock. The
+// caller owns the shared fence. Unenrolled session/role/team/parent writers remain a gap.
+export async function verifyCurrentNativeSession(
+  tx: AuthorityTransaction,
+  who: NativeSessionRef,
+  signal: AbortSignal,
+): Promise<boolean> {
+  signal.throwIfAborted();
+  const [row] = await tx
+    .select({ user: users, session: sessions, identity: authUsers })
+    .from(sessions)
+    .innerJoin(users, eq(users.id, sessions.userId))
+    .innerJoin(authUsers, eq(authUsers.id, users.id))
+    .where(and(eq(sessions.id, who.sessionId), eq(sessions.userId, who.userId)))
+    .limit(1);
+  signal.throwIfAborted();
+  if (
+    row === undefined ||
+    !row.user.isActive ||
+    row.user.invitedAt !== null ||
+    row.session.revokedAt !== null ||
+    row.session.authMethod === "legacy" ||
+    !row.identity.emailVerified ||
+    row.identity.email.toLowerCase() !== row.user.email.toLowerCase()
+  )
+    return false;
+
+  const policy = await readAuthPolicy(tx, signal);
+  // Sample AFTER authority reads: transaction now() and a pre-query JS Date both age while
+  // waiting. Numeric text avoids a driver timestamp/DateStyle or host-timezone assumption.
+  const clockResult = await tx.execute<{ milliseconds: string }>(
+    sql`SELECT (extract(epoch from clock_timestamp()) * 1000)::text AS milliseconds`,
+  );
+  signal.throwIfAborted();
+  const now = new Date(Number(clockResult.rows[0]?.milliseconds ?? "invalid"));
+  if (!Number.isFinite(now.getTime()))
+    throw new AppError(ERROR_IDS.DB_INVARIANT, "Current native session clock was invalid");
+  return evaluateSessionAccess({
+    ...policy,
+    active: row.user.isActive,
+    emailVerified: row.identity.emailVerified,
+    isAdmin: row.user.isAdmin,
+    twoFactorEnabled: row.identity.twoFactorEnabled,
+    assurance: row.session.assurance,
+    lastSeenAt: row.session.lastSeenAt,
+    expiresAt: row.session.expiresAt,
+    createdAt: row.session.createdAt,
+    now,
+  }).allowed;
+}
+
+// Invoke at the outer request transaction boundary, before the effect takes any other locks.
+// This freezes enrolled authority writers through local commit and checks wall-clock validity
+// at the callback tail; it cannot freeze time during COMMIT or terminate already-admitted work.
+// Callback effects must be rollbackable on tx. Provider I/O and process publication/notification
+// belong after successful wrapper commit: a tail denial cannot retract external effects.
+export async function withCurrentNativeActor<R extends Result<unknown, unknown>>(
+  db: Db,
+  who: NativeSessionRef,
+  signal: AbortSignal,
+  effect: (tx: AuthorityTransaction, actor: HydratedActor) => Promise<R>,
+): Promise<R | NativeSessionDenied> {
+  signal.throwIfAborted();
+  let failedResult: R | NativeSessionDenied | undefined;
+  try {
+    return await db.transaction(
+      async (tx) => {
+        await lockCurrentAuthorityRead(tx, signal);
+        if (!(await verifyCurrentNativeSession(tx, who, signal)))
+          return err("native_session_invalid" as const);
+        const actor = await hydrateActor(tx, who.userId, signal);
+        if (actor === null) return err("native_session_invalid" as const);
+        const result = await effect(tx, actor);
+        signal.throwIfAborted();
+        if (!result.ok) {
+          failedResult = result;
+          tx.rollback();
+        }
+        if (!(await verifyCurrentNativeSession(tx, who, signal))) {
+          failedResult = err("native_session_invalid" as const);
+          tx.rollback();
+        }
+        signal.throwIfAborted();
+        return result;
+      },
+      { isolationLevel: "read committed" },
+    );
+  } catch (error) {
+    // Rollback/commit/transport/native errors are never retried or translated into denials.
+    if (failedResult !== undefined && error instanceof TransactionRollbackError)
+      return failedResult;
+    throw error;
+  }
+}
