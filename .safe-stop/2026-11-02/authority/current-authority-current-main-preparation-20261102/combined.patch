+  permissionEffects,
+  repeatableReadRoot,
+  settledOrAdvisoryRequest,
+  trackedTask,
+} from "./currentAuthorityIsolation.test-helpers";
+import { withCurrentNativeActor } from "./currentNativeSession";
+
+let h: TestDb;
+beforeEach(async () => {
+  h = await makeTestDb();
+});
+afterEach(async () => {
+  await h.close();
+});
+
+test("root native admission overrides RR defaults and sees flag revocation committed while queued", async () => {
+  const f = await currentAuthorityFixture(h);
+  const before = await readDealEffects(h, f);
+  let observed: { isolation: string; canEdit: boolean } | undefined;
+  await repeatableReadRoot(h, async (db, pid) => {
+    const remover = heldTransaction(h, (tx) => replaceEditFlag(tx, f, false));
+    let command: ReturnType<typeof trackedTask> | undefined;
+    try {
+      expect(await remover.ready).toEqual({ ok: true, value: true });
+      command = trackedTask(
+        withCurrentNativeActor(db, f.ref, authoritySignal(), async (tx, actor) => {
+          const result = await tx.execute<{ isolation: string }>(
+            sql`SELECT current_setting('transaction_isolation') AS isolation`,
+          );
+          const row = result.rows[0];
+          assert(row !== undefined);
+          observed = { isolation: row.isolation, canEdit: actor.flags.has("deal.edit_own") };
+          return updateDeal(
+            tx,
+            actor,
+            {
+              dealId: f.f.deals.visible.id,
+              expectedUpdatedAt: f.f.deals.visible.updatedAt.toISOString(),
+              title: "Must deny after RR queue",
+            },
+            authoritySignal(),
+          );
+        }),
+      );
+      await waitForBackendLock(h, pid, "advisory");
+      await assertQueuedSnapshot(h, pid);
+    } finally {
+      remover.release();
+      await Promise.all([remover.drained, command?.drained]);
+    }
+    assert(command !== undefined);
+    expect(await remover.task).toEqual({ ok: true, value: true });
+    expect
+      .soft(await command.task)
+      .toMatchObject({ ok: false, error: { id: ERROR_IDS.PERM_DENIED } });
+  });
+  expect.soft(observed).toEqual({ isolation: "read committed", canEdit: false });
+  expect(await readDealEffects(h, f)).toEqual(before);
+});
+
+test("root flags writer overrides RR defaults and rechecks a revoked manager grant after its wait", async () => {
+  const f = await currentAuthorityFixture(h);
+  const manager = await delegatedManager(h);
+  const before = await permissionEffects(h, f.permissionSet.id);
+  await repeatableReadRoot(h, async (db, pid) => {
+    // Revoke the manager's OWN set, then edit a DIFFERENT target. A same-row RR update
+    // would produce 40001 and could mask the stale-authority acceptance being tested.
+    const remover = heldTransaction(h, (tx) =>
+      updatePermissionSetFlags(
+        tx,
+        f.admin,
+        { setId: manager.set.id, flags: {} },
+        authoritySignal(),
+      ),
+    );
+    let command: ReturnType<typeof trackedTask> | undefined;
+    try {
+      expect(await remover.ready).toEqual({ ok: true, value: true });
+      command = trackedTask(
+        updatePermissionSetFlags(
+          db,
+          manager.actor,
+          {
+            setId: f.permissionSet.id,
+            flags: { ...f.permissionSet.flags, "deal.edit_own": false },
+          },
+          authoritySignal(),
+        ),
+      );
+      await waitForBackendLock(h, pid, "advisory");
+      await assertQueuedSnapshot(h, pid);
+    } finally {
+      remover.release();
+      await Promise.all([remover.drained, command?.drained]);
+    }
+    assert(command !== undefined);
+    expect(await remover.task).toEqual({ ok: true, value: true });
+    expect.soft(await command.task).toEqual({ ok: false, error: "permissions.manage required" });
+  });
+  expect(await permissionEffects(h, f.permissionSet.id)).toEqual(before);
+});
+
+test("an already-open RR native adapter fails with the operational invariant before asking for a fence", async () => {
+  const f = await currentAuthorityFixture(h);
+  const before = await readDealEffects(h, f);
+  const blocker = heldTransaction(h, (tx) => lockCurrentAuthorityWrite(tx, authoritySignal()));
+  let entered = false;
+  let ordering: "settled" | "advisory_requested" | undefined;
+  let run: ReturnType<typeof openRepeatableRead> | undefined;
+  try {
+    await blocker.ready;
+    run = openRepeatableRead(h, (tx) =>
+      withCurrentNativeActor(tx, f.ref, authoritySignal(), (guarded, actor) => {
+        entered = true;
+        return updateDeal(
+          guarded,
+          actor,
+          {
+            dealId: f.f.deals.visible.id,
+            expectedUpdatedAt: f.f.deals.visible.updatedAt.toISOString(),
+            title: "Must reject open RR adapter",
+          },
+          authoritySignal(),
+        );
+      }),
+    );
+    ordering = await settledOrAdvisoryRequest(h, await run.backend, run);
+  } finally {
+    blocker.release();
+    await Promise.all([blocker.drained, run?.drained]);
+  }
+  assert(run !== undefined);
+  await blocker.task;
+  expect.soft(ordering).toBe("settled");
+  expect.soft(entered).toBe(false);
+  const outcome = await run.drained;
+  expect.soft(outcome.status).toBe("rejected");
+  if (outcome.status === "rejected") {
+    expect.soft(outcome.reason).toBeInstanceOf(AppError);
+    expect.soft(outcome.reason).toMatchObject({
+      id: ERROR_IDS.DB_INVARIANT,
+      message: "Current authority requires read committed",
+    });
+  }
+  expect.soft(await readDealEffects(h, f)).toEqual(before);
+  expect(
+    await withCurrentNativeActor(h.db, f.ref, authoritySignal(), () => Promise.resolve(ok(true))),
+  ).toEqual({ ok: true, value: true });
+});
+
+test("an already-open RR flags adapter fails with the operational invariant before asking for a fence", async () => {
+  const f = await currentAuthorityFixture(h);
+  const before = await permissionEffects(h, f.permissionSet.id);
+  const blocker = heldTransaction(h, (tx) => lockCurrentAuthorityWrite(tx, authoritySignal()));
+  let ordering: "settled" | "advisory_requested" | undefined;
+  let run: ReturnType<typeof openRepeatableRead> | undefined;
+  try {
+    await blocker.ready;
+    run = openRepeatableRead(h, (tx) => replaceEditFlag(tx, f, false));
+    ordering = await settledOrAdvisoryRequest(h, await run.backend, run);
+  } finally {
+    blocker.release();
+    await Promise.all([blocker.drained, run?.drained]);
+  }
+  assert(run !== undefined);
+  await blocker.task;
+  expect.soft(ordering).toBe("settled");
+  const outcome = await run.drained;
+  expect.soft(outcome.status).toBe("rejected");
+  if (outcome.status === "rejected") {
+    expect.soft(outcome.reason).toBeInstanceOf(AppError);
+    expect.soft(outcome.reason).toMatchObject({
+      id: ERROR_IDS.DB_INVARIANT,
+      message: "Current authority requires read committed",
+    });
+  }
+  expect.soft(await permissionEffects(h, f.permissionSet.id)).toEqual(before);
+  expect(await h.db.transaction((tx) => replaceEditFlag(tx, f, false))).toEqual({
+    ok: true,
+    value: true,
+  });
+});
