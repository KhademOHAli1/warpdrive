new file mode 100644
--- /dev/null
+++ b/src/features/auth/currentAuthorityIsolation.test-helpers.ts
@@ -0,0 +1,141 @@
+import assert from "node:assert/strict";
+import { eq, sql } from "drizzle-orm";
+import { drizzle } from "drizzle-orm/node-postgres";
+import type { Db } from "@/db/client";
+import * as schema from "@/db/schema";
+import { auditEvents, permissionSets, users } from "@/db/schema";
+import { hydrateActor } from "@/server/hydrateActor";
+import type { TestDb } from "@/test/db";
+import { authoritySignal, boundedAuthorityProbe, deferred } from "./currentAuthority.test-helpers";
+import type { AuthorityTransaction } from "./currentAuthorityFence";
+
+export function trackedTask<T>(task: Promise<T>) {
+  let settled = false;
+  const drained = task.then(
+    (value) => {
+      settled = true;
+      return { status: "fulfilled" as const, value };
+    },
+    (reason: unknown) => {
+      settled = true;
+      return { status: "rejected" as const, reason };
+    },
+  );
+  return { task, drained, isSettled: () => settled };
+}
+
+// A genuine ROOT Drizzle Db over a public checked-out client. No surrounding transaction
+// primes the snapshot or turns the entry under test into a nested savepoint.
+export async function repeatableReadRoot<T>(
+  h: TestDb,
+  work: (db: Db, pid: number) => Promise<T>,
+): Promise<T> {
+  const client = await h.pool.connect();
+  try {
+    await client.query(
+      "SET SESSION CHARACTERISTICS AS TRANSACTION ISOLATION LEVEL REPEATABLE READ",
+    );
+    await client.query("SET statement_timeout = '8s'");
+    const defaults = await client.query<{ default_transaction_isolation: string }>(
+      "SHOW default_transaction_isolation",
+    );
+    assert.equal(defaults.rows[0]?.default_transaction_isolation, "repeatable read");
+    const backend = await client.query<{ pid: number }>("SELECT pg_backend_pid() AS pid");
+    const pid = backend.rows[0]?.pid;
+    assert(pid !== undefined, "root fixture backend missing");
+    return await work(drizzle(client, { schema }), pid);
+  } finally {
+    // The callback drains its commands first. Discard this owned fixture connection so its
+    // changed session defaults cannot escape into a later pooled test transaction.
+    client.release(true);
+  }
+}
+
+export function openRepeatableRead<T>(h: TestDb, work: (tx: AuthorityTransaction) => Promise<T>) {
+  const backend = deferred<number>();
+  void backend.promise.catch(() => undefined);
+  const run = trackedTask(
+    h.db.transaction(
+      async (tx) => {
+        await tx.execute(sql`SET LOCAL statement_timeout = '8s'`);
+        const result = await tx.execute<{ pid: number }>(sql`SELECT pg_backend_pid() AS pid`);
+        const row = result.rows[0];
+        assert(row !== undefined, "adapter fixture backend missing");
+        backend.resolve(row.pid);
+        return work(tx);
+      },
+      { isolationLevel: "repeatable read" },
+    ),
+  );
+  void run.drained.then((outcome) => {
+    if (outcome.status === "rejected") backend.reject(outcome.reason);
+  });
+  return { ...run, backend: backend.promise };
+}
+
+export async function assertQueuedSnapshot(h: TestDb, pid: number) {
+  const result = await boundedAuthorityProbe<{
+    advisory_wait: boolean;
+    has_snapshot: boolean;
+    in_transaction: boolean;
+  }>(
+    h,
+    {
+      text: `SELECT wait_event='advisory' AS advisory_wait,
+      backend_xmin IS NOT NULL AS has_snapshot, xact_start IS NOT NULL AS in_transaction
+      FROM pg_stat_activity WHERE datname=current_database() AND pid=$1`,
+      values: [pid],
+    },
+    authoritySignal(),
+  );
+  assert.deepEqual(result.rows, [
+    { advisory_wait: true, has_snapshot: true, in_transaction: true },
+  ]);
+}
+
+export async function settledOrAdvisoryRequest(
+  h: TestDb,
+  pid: number,
+  run: { isSettled: () => boolean },
+): Promise<"settled" | "advisory_requested"> {
+  const signal = AbortSignal.timeout(5000);
+  for (;;) {
+    signal.throwIfAborted();
+    if (run.isSettled()) return "settled";
+    const result = await boundedAuthorityProbe<{ requested: boolean }>(
+      h,
+      {
+        text: "SELECT EXISTS (SELECT 1 FROM pg_locks WHERE pid=$1 AND locktype='advisory') AS requested",
+        values: [pid],
+      },
+      signal,
+    );
+    signal.throwIfAborted();
+    if (result.rows[0]?.requested === true) return "advisory_requested";
+    // This only paces observation. Actual settlement/advisory state is the ordering oracle.
+    await new Promise<void>((resolve) => setTimeout(resolve, 10));
+  }
+}
+
+export async function delegatedManager(h: TestDb) {
+  const [set] = await h.db
+    .insert(permissionSets)
+    .values({ name: "RR delegated managers", flags: { "permissions.manage": true } })
+    .returning();
+  assert(set !== undefined);
+  const [user] = await h.db
+    .insert(users)
+    .values({ email: "rr-manager@example.test", name: "RR manager", permissionSetId: set.id })
+    .returning();
+  assert(user !== undefined);
+  const actor = await hydrateActor(h.db, user.id, authoritySignal());
+  assert(actor !== null, "delegated manager fixture must exist");
+  assert(actor.flags.has("permissions.manage"), "delegated manager fixture must be allowed");
+  return { set, actor };
+}
+
+export async function permissionEffects(h: TestDb, setId: string) {
+  const rows = await h.db.select().from(permissionSets).where(eq(permissionSets.id, setId));
+  const audit = await h.db.select().from(auditEvents).where(eq(auditEvents.targetId, setId));
+  return { rows, audit };
+}
