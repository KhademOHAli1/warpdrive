+test("a root flags writer rolls back its changed flag when the real audit insert fails", async () => {
+  const f = await currentAuthorityFixture(h);
+  const before = await h.db
+    .select()
+    .from(permissionSets)
+    .where(eq(permissionSets.id, f.permissionSet.id));
+  const beforeAudit = await h.db
+    .select()
+    .from(auditEvents)
+    .where(eq(auditEvents.targetId, f.permissionSet.id));
+  // Isolated disposable test database only. No trigger or production failure hook is needed.
+  await h.db.execute(sql`ALTER TABLE audit_events ADD CONSTRAINT current_authority_fixture_audit_reject
+    CHECK (action <> 'permission_set.update')`);
+  try {
+    const outcome = await updatePermissionSetFlags(
+      h.db,
+      f.admin,
+      { setId: f.permissionSet.id, flags: { ...f.permissionSet.flags, "deal.edit_own": false } },
+      AbortSignal.timeout(10_000),
+    ).then(
+      (value) => ({ status: "fulfilled" as const, value }),
+      (reason: unknown) => ({ status: "rejected" as const, reason }),
+    );
+    assert(outcome.status === "rejected", "the real audit CHECK must fail");
+    expect(outcome.reason).toMatchObject({ cause: { code: "23514" } });
+    expect(
+      await h.db.select().from(permissionSets).where(eq(permissionSets.id, f.permissionSet.id)),
+    ).toEqual(before);
+    expect(
+      await h.db.select().from(auditEvents).where(eq(auditEvents.targetId, f.permissionSet.id)),
+    ).toEqual(beforeAudit);
+  } finally {
+    await h.db.execute(
+      sql`ALTER TABLE audit_events DROP CONSTRAINT current_authority_fixture_audit_reject`,
+    );
+  }
+  // The transaction and exclusive fence were released even on the audit failure.
+  expect(
+    await updatePermissionSetFlags(
+      h.db,
+      f.admin,
+      { setId: f.permissionSet.id, flags: { ...f.permissionSet.flags, "deal.edit_own": false } },
+      AbortSignal.timeout(10_000),
+    ),
+  ).toEqual({ ok: true, value: true });
+});
