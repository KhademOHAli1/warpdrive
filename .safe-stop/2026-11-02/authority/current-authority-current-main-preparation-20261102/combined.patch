new file mode 100644
--- /dev/null
+++ b/src/features/auth/currentAuthorityFence.ts
@@ -0,0 +1,42 @@
+import { sql } from "drizzle-orm";
+import { AppError, ERROR_IDS } from "@/constants/errorIds";
+import type { Db } from "@/db/client";
+
+export type AuthorityTransaction = Parameters<Parameters<Db["transaction"]>[0]>[0];
+
+// Nested transaction options cannot change an existing snapshot. Reject an unsupported
+// adapter before requesting either fence, rather than accepting stale post-wait authority.
+async function assertReadCommitted(tx: AuthorityTransaction, signal: AbortSignal): Promise<void> {
+  signal.throwIfAborted();
+  const result = await tx.execute<{ isolation: string }>(
+    sql`SELECT current_setting('transaction_isolation') AS isolation`,
+  );
+  signal.throwIfAborted();
+  if (result.rows[0]?.isolation !== "read committed")
+    throw new AppError(ERROR_IDS.DB_INVARIANT, "Current authority requires read committed");
+}
+
+// Acquire before every other advisory/row lock, on the transaction that owns the effect.
+// Only enrolled writers participate; this is not global revocation coverage. Never upgrade
+// a shared holder to exclusive. Authority-changing commands must choose exclusive at entry.
+export async function lockCurrentAuthorityRead(
+  tx: AuthorityTransaction,
+  signal: AbortSignal,
+): Promise<void> {
+  await assertReadCommitted(tx, signal);
+  await tx.execute(
+    sql`SELECT pg_advisory_xact_lock_shared(hashtext('warpdrive-current-authority'), hashtext('actor-v1'))`,
+  );
+  signal.throwIfAborted();
+}
+
+export async function lockCurrentAuthorityWrite(
+  tx: AuthorityTransaction,
+  signal: AbortSignal,
+): Promise<void> {
+  await assertReadCommitted(tx, signal);
+  await tx.execute(
+    sql`SELECT pg_advisory_xact_lock(hashtext('warpdrive-current-authority'), hashtext('actor-v1'))`,
+  );
+  signal.throwIfAborted();
+}
