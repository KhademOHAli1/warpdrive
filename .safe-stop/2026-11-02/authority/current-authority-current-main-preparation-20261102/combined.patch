@@ -0,0 +1,229 @@
+import assert from "node:assert/strict";
+import { eq, sql } from "drizzle-orm";
+import { afterEach, beforeEach, expect, test } from "vitest";
+import { authUsers, permissionSets, sessions, teamMembers, teams, users } from "@/db/schema";
+import { updateDeal } from "@/features/deals/dealUpdate";
+import { makeTestDb, type TestDb } from "@/test/db";
+import { err } from "@/types/result";
+import {
+  authoritySignal,
+  currentAuthorityFixture,
+  editDeal,
+  readDealEffects,
+  readNativeState,
+} from "./currentAuthority.test-helpers";
+import { withCurrentNativeActor } from "./currentNativeSession";
+
+let h: TestDb;
+beforeEach(async () => {
+  h = await makeTestDb();
+});
+afterEach(async () => {
+  await h.close();
+});
+
+test("ordinary native edit needs no fresh proof, reloads team grants, and never touches authentication", async () => {
+  const f = await currentAuthorityFixture(h);
+  await h.db
+    .update(sessions)
+    .set({ freshAuthenticatedAt: sql`clock_timestamp() - interval '1 hour'` })
+    .where(eq(sessions.id, f.ref.sessionId));
+  await h.db
+    .update(permissionSets)
+    .set({ flags: { ...f.permissionSet.flags, "team.viewMembers": true } })
+    .where(eq(permissionSets.id, f.permissionSet.id));
+  const [team] = await h.db
+    .insert(teams)
+    .values({ name: "Current authority team", managerId: f.ref.userId })
+    .returning();
+  assert(team !== undefined);
+  await h.db.insert(teamMembers).values({ teamId: team.id, userId: f.f.users.outsider.id });
+  const before = await readNativeState(h, f.ref);
+  let managed: string[] = [];
+  const result = await withCurrentNativeActor(h.db, f.ref, authoritySignal(), (tx, actor) => {
+    managed = [...(actor.managedUserIds ?? [])];
+    return updateDeal(
+      tx,
+      actor,
+      {
+        dealId: f.f.deals.visible.id,
+        expectedUpdatedAt: f.f.deals.visible.updatedAt.toISOString(),
+        title: "Current native edit",
+      },
+      authoritySignal(),
+    );
+  });
+  expect(result.ok).toBe(true);
+  expect(managed).toEqual([f.f.users.outsider.id]);
+  expect(await readNativeState(h, f.ref)).toEqual(before);
+  const effects = await readDealEffects(h, f);
+  expect(effects.deal?.title).toBe("Current native edit");
+  expect(effects.logs).toHaveLength(1);
+  expect(Number(effects.versions[0]?.version)).toBe(1);
+});
+
+test.each([
+  "wrong_user",
+  "revoked",
+  "inactive",
+  "invited",
+  "unverified",
+  "identity_email_mismatch",
+  "legacy",
+  "pending",
+  "password_admin",
+] as const)("native admission rejects %s without work or authentication touches", async (kind) => {
+  const f = await currentAuthorityFixture(h);
+  switch (kind) {
+    case "revoked":
+      await h.db
+        .update(sessions)
+        .set({ revokedAt: sql`clock_timestamp()` })
