+import assert from "node:assert/strict";
+import { eq, sql } from "drizzle-orm";
+import { afterEach, beforeEach, expect, test } from "vitest";
+import { deals, sessions } from "@/db/schema";
+import { makeTestDb, type TestDb } from "@/test/db";
+import {
+  authoritySignal,
+  currentAuthorityFixture,
+  editDeal,
+  expireAfterTransactionBegan,
+  heldTransaction,
+  observedTransaction,
+  readDealEffects,
+  readNativeState,
+  replaceEditFlag,
+  waitForBackendLock,
+} from "./currentAuthority.test-helpers";
+import { lockCurrentAuthorityWrite } from "./currentAuthorityFence";
+
+let h: TestDb;
+beforeEach(async () => {
+  h = await makeTestDb();
+});
+afterEach(async () => {
+  await h.close();
+});
+
+test("native session expiry uses the database wall clock after waiting for the fence", async () => {
+  const f = await currentAuthorityFixture(h);
+  const before = await readDealEffects(h, f);
+  const fenceBlocker = heldTransaction(h, (tx) => lockCurrentAuthorityWrite(tx, authoritySignal()));
+  let command:
+    | ReturnType<typeof observedTransaction<Awaited<ReturnType<typeof editDeal>>>>
+    | undefined;
+  let afterExpiry: Awaited<ReturnType<typeof readNativeState>> | undefined;
+  try {
+    await fenceBlocker.ready;
+    command = observedTransaction(h, (tx) => editDeal({ db: tx }, f, "Expired while queued"));
+    const pid = await command.backend;
+    await waitForBackendLock(h, pid, "advisory");
+    // A fixture write sets the deadline to wall-clock now after BEGIN. This deterministically
+    // distinguishes transaction now() without relying on a fixed sleep or mocked clock.
+    await expireAfterTransactionBegan(h, f.ref, pid);
+    afterExpiry = await readNativeState(h, f.ref);
+  } finally {
+    fenceBlocker.release();
+    await Promise.all([fenceBlocker.drained, command?.drained]);
+  }
+  assert(command !== undefined && afterExpiry !== undefined);
+  await fenceBlocker.task;
+  expect(await command.task).toEqual({ ok: false, error: "native_session_invalid" });
+  expect(await readNativeState(h, f.ref)).toEqual(afterExpiry);
+  expect(await readDealEffects(h, f)).toEqual(before);
+  // The failed admission must have released its shared lock.
+  expect(await h.db.transaction((tx) => replaceEditFlag(tx, f, true))).toEqual({
+    ok: true,
+    value: true,
+  });
+});
+
+test("expiry during a real deal row wait rolls back the write, log and durable publication", async () => {
+  const f = await currentAuthorityFixture(h);
+  const before = await readDealEffects(h, f);
+  const rowBlocker = heldTransaction(h, async (tx) => {
+    await tx
+      .select({ id: deals.id })
+      .from(deals)
+      .where(eq(deals.id, f.f.deals.visible.id))
+      .for("update");
+  });
+  let command:
+    | ReturnType<typeof observedTransaction<Awaited<ReturnType<typeof editDeal>>>>
+    | undefined;
+  let afterExpiry: Awaited<ReturnType<typeof readNativeState>> | undefined;
+  try {
+    await rowBlocker.ready;
+    command = observedTransaction(h, (tx) => editDeal({ db: tx }, f, "Expired during write wait"));
+    const pid = await command.backend;
+    await waitForBackendLock(h, pid, "row");
+    await expireAfterTransactionBegan(h, f.ref, pid);
+    afterExpiry = await readNativeState(h, f.ref);
+  } finally {
+    rowBlocker.release();
+    await Promise.all([rowBlocker.drained, command?.drained]);
+  }
+  assert(command !== undefined && afterExpiry !== undefined);
+  await rowBlocker.task;
+  expect(await command.task).toEqual({ ok: false, error: "native_session_invalid" });
+  expect(await readNativeState(h, f.ref)).toEqual(afterExpiry);
+  expect(await readDealEffects(h, f)).toEqual(before);
+
+  // Both a valid real command and a real exclusive writer still work after the rollback.
+  await h.db
+    .update(sessions)
+    .set({ expiresAt: sql`clock_timestamp() + interval '1 hour'` })
+    .where(eq(sessions.id, f.ref.sessionId));
+  expect((await editDeal(h, f, "Valid after expiry rollback")).ok).toBe(true);
+  expect(await h.db.transaction((tx) => replaceEditFlag(tx, f, false))).toEqual({
+    ok: true,
+    value: true,
+  });
+  const afterControl = await readDealEffects(h, f);
+  expect(afterControl.deal?.title).toBe("Valid after expiry rollback");
+  expect(afterControl.logs).toHaveLength(before.logs.length + 1);
+  expect(Number(afterControl.versions[0]?.version)).toBe(
+    Number(before.versions[0]?.version ?? 0) + 1,
+  );
+});
