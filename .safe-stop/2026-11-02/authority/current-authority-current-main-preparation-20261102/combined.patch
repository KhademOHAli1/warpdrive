diff --git a/src/features/auth/currentAuthority.test-helpers.ts b/src/features/auth/currentAuthority.test-helpers.ts
new file mode 100644
--- /dev/null
+++ b/src/features/auth/currentAuthority.test-helpers.ts
@@ -0,0 +1,251 @@
+import assert from "node:assert/strict";
+import { and, eq, sql } from "drizzle-orm";
+import { Client, type QueryConfig, type QueryResult, type QueryResultRow } from "pg";
+import { dealChannel } from "@/constants/boardChannels";
+import { changeLogs, channelVersions, deals, permissionSets, sessions, users } from "@/db/schema";
+import { updateDeal } from "@/features/deals/dealUpdate";
+import { updatePermissionSetFlags } from "@/features/identity/permission-sets.service";
+import { hydrateActor } from "@/server/hydrateActor";
+import type { TestDb } from "@/test/db";
+import { createIntegrationPlatformFixtures } from "@/test/integrationPlatformFixtures";
+import type { AuthorityTransaction } from "./currentAuthorityFence";
+import { type NativeSessionRef, withCurrentNativeActor } from "./currentNativeSession";
+import { loadLiveSessionByToken } from "./session";
+
+export const authoritySignal = () => AbortSignal.timeout(10_000);
+
+// Keep observation on its own disposable fixture connection. Bounds belong to ClientConfig,
+// not QueryConfig; statement_timeout also bounds the SQL itself, not only its JS promise.
+export async function boundedAuthorityProbe<Row extends QueryResultRow>(
+  h: Pick<TestDb, "url">,
+  config: QueryConfig<unknown[]>,
+  signal: AbortSignal,
+) {
+  signal.throwIfAborted();
+  const client = new Client({
+    connectionString: h.url,
+    connectionTimeoutMillis: 1000,
+    statement_timeout: 1000,
+    query_timeout: 1500,
+    pipeline: false,
+  });
+  let transportError: Error | undefined;
+  client.on("error", (error: Error) => {
+    transportError ??= error;
+  });
+  let outcome: { ok: true; value: QueryResult<Row> } | { ok: false; error: unknown };
+  let cleanupFailed = false;
+  let cleanupError: unknown;
+  try {
+    try {
+      await client.connect();
+      signal.throwIfAborted();
+      const result = await client.query<Row, unknown[]>(config);
+      signal.throwIfAborted();
+      outcome = { ok: true, value: result };
+    } catch (error) {
+      outcome = { ok: false, error };
+    }
+  } finally {
+    try {
+      await client.end();
+    } catch (error) {
+      cleanupFailed = true;
+      cleanupError = error;
+    }
+  }
+  if (cleanupFailed) {
+    if (!outcome.ok)
+      throw new AggregateError([outcome.error, cleanupError], "Authority probe and cleanup failed");
+    throw cleanupError;
+  }
+  if (!outcome.ok) throw outcome.error;
+  if (transportError !== undefined) throw transportError;
+  return outcome.value;
+}
+
+export function deferred<T>() {
+  let resolve: (value: T) => void = () => undefined;
+  let reject: (error: unknown) => void = () => undefined;
+  const promise = new Promise<T>((done, fail) => {
+    resolve = done;
+    reject = fail;
+  });
+  return { promise, resolve, reject };
+}
+
+export async function currentAuthorityFixture(h: TestDb) {
+  const seeded = await createIntegrationPlatformFixtures(
+    h,
+    { namespace: "currentauthority", now: new Date() },
+    authoritySignal(),
+  );
+  assert(seeded.ok, "native authority fixture setup failed");
+  const f = seeded.value;
+  // This is real cookie-token lookup; the new internal-ID helper is not authentication.
+  const authenticated = await loadLiveSessionByToken(
+    h.db,
+    f.sessions.member.token,
+    authoritySignal(),
+  );
+  assert(authenticated.ok, "fixture cookie did not authenticate");
+  const ref: NativeSessionRef = authenticated.value;
+  const admin = await hydrateActor(h.db, f.users.admin.id, authoritySignal());
+  assert(admin?.type === "admin", "fixture administrator missing");
+  assert(f.users.member.permissionSetId !== null, "fixture member permission set missing");
+  const [permissionSet] = await h.db
+    .select()
+    .from(permissionSets)
+    .where(eq(permissionSets.id, f.users.member.permissionSetId));
+  assert(permissionSet !== undefined, "fixture permission set missing");
+  return { f, ref, admin, permissionSet };
+}
+
+export type CurrentAuthorityFixture = Awaited<ReturnType<typeof currentAuthorityFixture>>;
+
+export function editDeal(h: Pick<TestDb, "db">, f: CurrentAuthorityFixture, title: string) {
+  return withCurrentNativeActor(h.db, f.ref, authoritySignal(), (tx, actor) =>
+    updateDeal(
+      tx,
+      actor,
+      {
+        dealId: f.f.deals.visible.id,
+        expectedUpdatedAt: f.f.deals.visible.updatedAt.toISOString(),
+        title,
+      },
+      authoritySignal(),
+    ),
+  );
+}
+
+export function replaceEditFlag(
+  tx: AuthorityTransaction,
+  f: CurrentAuthorityFixture,
+  enabled: boolean,
+) {
+  return updatePermissionSetFlags(
+    tx,
+    f.admin,
+    { setId: f.permissionSet.id, flags: { ...f.permissionSet.flags, "deal.edit_own": enabled } },
+    authoritySignal(),
+  );
+}
+
+// The outer transaction identifies this exact connection before the real command acquires
+// its fence. It takes no data/advisory lock and adds no production interception hook.
+export function observedTransaction<T>(
+  h: TestDb,
+  effect: (tx: AuthorityTransaction) => Promise<T>,
+) {
+  const backend = deferred<number>();
+  void backend.promise.catch(() => undefined);
+  let settled = false;
+  const task = h.db.transaction(async (tx) => {
+    await tx.execute(sql`SET LOCAL statement_timeout = '8s'`);
+    const result = await tx.execute<{ pid: number }>(sql`SELECT pg_backend_pid() AS pid`);
+    const row = result.rows[0];
+    assert(row !== undefined, "test backend missing");
+    backend.resolve(row.pid);
+    return effect(tx);
+  });
+  const drained = task.then(
+    (value) => {
+      settled = true;
+      return { status: "fulfilled" as const, value };
+    },
+    (reason: unknown) => {
+      settled = true;
+      backend.reject(reason);
+      return { status: "rejected" as const, reason };
+    },
+  );
+  return { task, drained, backend: backend.promise, isSettled: () => settled };
+}
+
+export function heldTransaction<T>(h: TestDb, setup: (tx: AuthorityTransaction) => Promise<T>) {
+  const ready = deferred<T>();
+  const release = deferred<void>();
+  void ready.promise.catch(() => undefined);
+  const control = observedTransaction(h, async (tx) => {
+    const value = await setup(tx);
+    ready.resolve(value);
+    await release.promise;
+    return value;
+  });
+  void control.drained.then((outcome) => {
+    if (outcome.status === "rejected") ready.reject(outcome.reason);
+  });
+  return { ...control, ready: ready.promise, release: () => release.resolve(undefined) };
+}
+
+export async function waitForBackendLock(h: TestDb, pid: number, kind: "advisory" | "row") {
+  const signal = AbortSignal.timeout(5000);
+  for (;;) {
+    signal.throwIfAborted();
+    const result = await boundedAuthorityProbe<{ waiting: boolean }>(
+      h,
+      {
+        text: `SELECT EXISTS (
+        SELECT 1 FROM pg_stat_activity WHERE datname=current_database() AND pid=$1
+        AND wait_event_type='Lock' AND
+        (($2='advisory' AND wait_event='advisory') OR
+         ($2='row' AND wait_event IN ('tuple','transactionid')))
+      ) AS waiting`,
+        values: [pid, kind],
+      },
+      signal,
+    );
+    signal.throwIfAborted();
+    if (result.rows[0]?.waiting === true) return;
+    // Poll cadence only; transaction barriers, not elapsed sleeps, decide test order.
+    await new Promise<void>((resolve) => setTimeout(resolve, 10));
+  }
+}
+
+export async function expireAfterTransactionBegan(h: TestDb, ref: NativeSessionRef, pid: number) {
+  const signal = authoritySignal();
+  signal.throwIfAborted();
+  const [expired] = await h.db
+    .update(sessions)
+    .set({ expiresAt: sql`clock_timestamp()` })
+    .where(eq(sessions.id, ref.sessionId))
+    .returning({ expiresAt: sessions.expiresAt });
+  assert(expired !== undefined, "session expiry fixture missing");
+  const proof = await boundedAuthorityProbe<{ started_before_expiry: boolean; expired: boolean }>(
+    h,
+    {
+      text: `SELECT a.xact_start < s.expires_at AS started_before_expiry,
+      clock_timestamp() >= s.expires_at AS expired
+      FROM pg_stat_activity a CROSS JOIN sessions s WHERE a.pid=$1 AND s.id=$2`,
+      values: [pid, ref.sessionId],
+    },
+    signal,
+  );
+  assert(
+    proof.rows[0]?.started_before_expiry === true,
+    "test transaction must predate session expiry",
+  );
+  assert(proof.rows[0].expired, "database wall clock must have reached fixture expiry");
+}
+
+export async function readNativeState(h: TestDb, ref: NativeSessionRef) {
+  const [session] = await h.db.select().from(sessions).where(eq(sessions.id, ref.sessionId));
+  const [user] = await h.db.select().from(users).where(eq(users.id, ref.userId));
+  assert(session !== undefined && user !== undefined, "native state fixture missing");
+  return { session, user };
+}
+
+export async function readDealEffects(h: TestDb, f: CurrentAuthorityFixture) {
+  const id = f.f.deals.visible.id;
+  const [deal] = await h.db.select().from(deals).where(eq(deals.id, id));
+  const logs = await h.db
+    .select()
+    .from(changeLogs)
+    .where(and(eq(changeLogs.entityType, "deal"), eq(changeLogs.entityId, id)))
+    .orderBy(changeLogs.id);
+  const versions = await h.db
+    .select()
+    .from(channelVersions)
+    .where(eq(channelVersions.channel, dealChannel(id)));
+  return { deal, logs, versions };
+}
