{
  "name": "warpdrive-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Public Warpdrive documentation, exported as a static Fumadocs site.",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --bun next dev --webpack",
    "build": "bun --bun next build --webpack",
    "typecheck": "bun --bun next typegen && bun --bun tsc --noEmit",
    "check:export": "bun ./scripts/check-export.mjs"
  },
  "dependencies": {
    "fumadocs-core": "16.19.0",
    "fumadocs-mdx": "15.6.1",
    "fumadocs-ui": "16.19.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "parse5": "8.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  },
  "overrides": {
    "baseline-browser-mapping@^2": "2.11.35",
    "nanoid@^3": "3.3.20",
    "postcss@^8": "8.5.32",
    "source-map-js@^1": "1.2.2"
  }
}
