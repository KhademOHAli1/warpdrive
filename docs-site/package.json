{
  "name": "warpdrive-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site for Warpdrive (Docusaurus, deployed to Cloudflare Pages).",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "docusaurus": "bun --bun ./node_modules/.bin/docusaurus",
    "start": "bun --bun ./node_modules/.bin/docusaurus start",
    "build": "bun --bun ./node_modules/.bin/docusaurus build",
    "swizzle": "bun --bun ./node_modules/.bin/docusaurus swizzle",
    "clear": "bun --bun ./node_modules/.bin/docusaurus clear",
    "serve": "bun --bun ./node_modules/.bin/docusaurus serve",
    "write-translations": "bun --bun ./node_modules/.bin/docusaurus write-translations",
    "write-heading-ids": "bun --bun ./node_modules/.bin/docusaurus write-heading-ids",
    "typecheck": "bun --bun tsc"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.3.0",
    "typescript": "~7.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
