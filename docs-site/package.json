{
  "name": "warpdrive-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation site for Warpdrive (Docusaurus, deployed to Cloudflare Pages).",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "docusaurus": "bun --bun ./node_modules/.bin/docusaurus",
    "start": "bun --bun ./node_modules/.bin/docusaurus start",
    "build": "bun --bun ./node_modules/.bin/docusaurus build",
    "swizzle": "bun --bun ./node_modules/.bin/docusaurus swizzle",
    "clear": "bun --bun ./node_modules/.bin/docusaurus clear",
    "serve": "bun --bun ./node_modules/.bin/docusaurus serve",
    "write-translations": "bun --bun ./node_modules/.bin/docusaurus write-translations",
    "write-heading-ids": "bun --bun ./node_modules/.bin/docusaurus write-heading-ids",
    "typecheck": "bun --bun tsc"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.3.0",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "@swc/html@^1": "1.15.47",
    "baseline-browser-mapping@^2": "2.11.35",
    "body-parser@^1": "1.20.9",
    "brace-expansion@^1": "1.1.21",
    "browserslist@^4": "4.29.5",
    "colord@^2": "2.9.4",
    "compression@^1": "1.8.2",
    "fast-uri@^3": "3.1.9",
    "follow-redirects@^1": "1.16.2",
    "image-size@^2": "2.0.4",
    "joi@^17": "17.13.9",
    "js-yaml@^4": "4.3.2",
    "launch-editor@^2": "2.14.2",
    "nanoid@^3": "3.3.20",
    "postcss@^8": "8.5.32",
    "postcss-selector-parser@^6": "6.1.5",
    "postcss-selector-parser@^7": "7.1.7",
    "proxy-addr@^2": "2.0.8",
    "qs@^6": "6.16.1",
    "shell-quote@^1": "1.11.0",
    "source-map-js@^1": "1.2.2",
    "svgo@^3": "3.3.5",
    "undici@^7": "7.30.1",
    "tinypool@^1": "2.1.2",
    "serialize-javascript@^6": "7.1.3",
    "uuid@^8": "11.1.1",
    "serve-handler@6.1.7>minimatch": "11.0.4",
    "deepmerge@^4": "npm:@fastify/deepmerge@3.2.4"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "patchedDependencies": {
    "serve-handler@6.1.7": "patches/serve-handler@6.1.7.patch",
    "@fastify/deepmerge@3.2.4": "patches/@fastify-deepmerge@3.2.4.patch"
  }
}
