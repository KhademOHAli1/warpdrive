# Keep secrets, VCS, and local-only material out of image layers (F20). The build stage
# does `COPY . .`, so anything not excluded here is baked into the image and the runtime
# filesystem. Exclude env files, git history, caches, test/evidence output, and node_modules
# (deps are installed in a dedicated stage from the lockfile).
.env
.env.*
!.env.example
.git
.gitignore
node_modules
**/node_modules
.next
**/.next
dist
build
coverage
test-results
**/__pycache__
*.log
npm-debug.log*
pnpm-debug.log*

# Local harness / self-improvement scratch (gitignored, must never ship).
.harness
.superpowers
# Claude Code local state and git worktrees (worktrees carry their own .next caches, which
# otherwise bloat the build context and can exhaust disk on a local docker build).
.claude
# Private finite profiles include credentials, dumps and local database files.
.runtime
**/.runtime

# Editor / OS cruft
.vscode
.idea
.DS_Store

# Source-only fixtures and docs are not needed in the image build context.
**/*.test.ts
**/*.test-helpers.ts
**/*.harness.ts
# Required for typechecking the disposable integration-profile smoke script.
!src/features/auth/session.test-helpers.ts
docs
