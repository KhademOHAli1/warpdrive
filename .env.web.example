# Presentation runtime only. No database, authentication, provider or storage secrets.
# Set these deployment variables for the standalone image-only Compose project.
WARPDRIVE_WEB_IMAGE=
WARPDRIVE_WEB_PORT=3000
CORE_API_ORIGIN=https://backend.example.com
CORE_PROXY_TOKEN=
# Browser-facing origin. Keep it identical to Core BASE_URL.
WEB_PUBLIC_ORIGIN=https://app.example.com
# Caddy must overwrite X-Real-IP. Use none for direct local requests.
# For Cloudflare ingress use cf-connecting-ip after adapter qualification.
FRONTEND_TRUSTED_PROXY_HEADER=x-real-ip
APP_VERSION=
APP_COMMIT=
# Build-time setting; keeps the public WebSocket path on the app origin.
NEXT_PUBLIC_WS_URL=same-origin
