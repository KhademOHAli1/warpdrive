{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "incremental": false,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [
    "*.mjs",
    "scripts/*.mjs",
    "scripts/deployment/component_inputs.mjs",
    "scripts/deployment/component_inputs.test.mjs",
    "scripts/deployment/component_boundaries.mjs",
    ".env.example.test.ts"
  ],
  "exclude": ["node_modules", "site", "docs-site", ".runtime"]
}
